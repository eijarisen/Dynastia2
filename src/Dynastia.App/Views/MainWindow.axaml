<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Dynastia.App.ViewModels"
    xmlns:contracts="using:Dynastia.Contracts"
    xmlns:ui="using:Dynastia.App.Controls"
    xmlns:conv="using:Dynastia.App.Converters"
    x:Class="Dynastia.App.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d"
    Width="1672"
    Height="941"
    WindowState="Maximized"
    MinWidth="1180"
    MinHeight="700"
    Background="#020809"
    Title="Dynastia">

    <Window.Resources>
        <conv:StatValueBrushConverter
            x:Key="StatValueBrushConverter" />

        <conv:HealthBrushConverter
            x:Key="HealthBrushConverter" />

        <conv:SatisfactionBrushConverter
            x:Key="SatisfactionBrushConverter" />

        <DataTemplate
            x:Key="FamilyCardTemplate"
            x:DataType="vm:FamilyMemberCardViewModel">

            <Button
                Classes="familyCard"
                Classes.living="{Binding IsLiving}"
                Classes.deceased="{Binding IsDeceased}"
                Classes.selected="{Binding IsSelected}"
                Classes.head="{Binding IsActiveHouseholdHead}"
                Command="{Binding SelectCommand}">

                <ToolTip.Tip>
                    <Border
                        MaxWidth="390"
                        Padding="10,7"
                        Background="#F20A1514"
                        BorderBrush="#B88934"
                        BorderThickness="1"
                        CornerRadius="4">

                        <Grid>
                            <StackPanel
                                IsVisible="{Binding IsLiving}"
                                Spacing="3">

                                <TextBlock
                                    IsVisible="{Binding HasTooltipThought}"
                                    Margin="0,0,0,4"
                                    FontSize="12"
                                    LineHeight="18"
                                    Foreground="#F5E6C6"
                                    TextWrapping="Wrap"
                                    Text="{Binding TooltipThoughtText}" />

                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding HealthValue, Converter={StaticResource HealthBrushConverter}}"
                                    Text="{Binding HealthTooltipText}" />

                                <TextBlock
                                    IsVisible="{Binding ShowStress}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#D6B76A"
                                    Text="{Binding StressTooltipText}" />

                                <TextBlock
                                    IsVisible="{Binding ShowChildEducation}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding ChildEducationLevel, Converter={StaticResource StatValueBrushConverter}}"
                                    Text="{Binding ChildEducationTooltipText}" />

                                <TextBlock
                                    IsVisible="{Binding ShowChildHappiness}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding ChildHappinessLabel, Converter={StaticResource SatisfactionBrushConverter}}"
                                    Text="{Binding ChildHappinessTooltipText}" />

                                <TextBlock
                                    IsVisible="{Binding ShowAdultSatisfaction}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding CareerSatisfactionLabel,
                                                         Converter={StaticResource SatisfactionBrushConverter}}"
                                    Text="{Binding CareerTooltipText}" />

                                <TextBlock
                                    IsVisible="{Binding ShowAdultSatisfaction}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding MarriageSatisfactionLabel,
                                                         Converter={StaticResource SatisfactionBrushConverter}}"
                                    Text="{Binding MarriageTooltipText}" />
                            </StackPanel>

                            <TextBlock
                                IsVisible="{Binding IsDeceased}"
                                FontSize="12"
                                LineHeight="18"
                                Foreground="#F5E6C6"
                                TextWrapping="Wrap"
                                Text="{Binding InfoTooltipText}" />
                        </Grid>
                    </Border>
                </ToolTip.Tip>

                <Grid Width="128">
                    <StackPanel
                        Width="128"
                        HorizontalAlignment="Center"
                        Spacing="2">

                        <TextBlock
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextAlignment="Center"
                            FontSize="35"
                            Text="{Binding AvatarText}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Text="{Binding FirstName}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Text="{Binding Surname}" />

                    <ProgressBar
                        Classes="healthBar"
                        IsVisible="{Binding ShowHealth}"
                        Width="100"
                        MinWidth="0"
                        MaxWidth="100"
                        Height="5"
                        Minimum="0"
                        Maximum="100"
                        HorizontalAlignment="Center"
                        Foreground="{Binding HealthValue,
                                             Converter={StaticResource HealthBrushConverter}}"
                        Value="{Binding HealthValue}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        FontSize="11"
                        Opacity="0.84"
                        Text="{Binding LifeSpanText}" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontSize="10.5"
                        Opacity="0.8"
                        Text="{Binding TownText}" />

                        <TextBlock
                            IsVisible="{Binding ShowOccupation}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            FontSize="10.5"
                            Opacity="0.78"
                            Text="{Binding OccupationText}" />
                    </StackPanel>

                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate
            x:Key="CompactStatTemplate"
            x:DataType="contracts:StatValue">

            <StackPanel
                Width="62"
                HorizontalAlignment="Center"
                Spacing="0">

                <TextBlock
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    FontSize="9.5"
                    FontWeight="SemiBold"
                    Foreground="{Binding Value,
                                         Converter={StaticResource StatValueBrushConverter}}"
                    Text="{Binding Name}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Georgia"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{Binding Value,
                                         Converter={StaticResource StatValueBrushConverter}}"
                    Text="{Binding Value}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="Foreground" Value="#F2E6CB" />
        </Style>

        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Georgia" />
        </Style>

        <Style Selector="Button.gameAction">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Background" Value="#E00A1C1A" />
            <Setter Property="Foreground" Value="#F8E9C8" />
            <Setter Property="BorderBrush" Value="#B98A34" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.gameAction:pointerover">
            <Setter Property="Background" Value="#F01A332D" />
            <Setter Property="Foreground" Value="#FFF2CE" />
            <Setter Property="BorderBrush" Value="#E7BC55" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.gameAction:pressed">
            <Setter Property="Background" Value="#F02D1A0B" />
            <Setter Property="Foreground" Value="#FFF1CB" />
            <Setter Property="BorderBrush" Value="#F0CE72" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.relationshipLink">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E9D8B3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.relationshipLink:pointerover">
            <Setter Property="Foreground" Value="#F1CE70" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.relationshipLink:disabled">
            <Setter Property="Foreground" Value="#E9D8B3" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.playableTab">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,5" />
            <Setter Property="Background" Value="#D00B1C1B" />
            <Setter Property="Foreground" Value="#F4E8CB" />
            <Setter Property="BorderBrush" Value="#715722" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.playableTab:pointerover">
            <Setter Property="Foreground" Value="#FFF1CB" />
            <Setter Property="Background" Value="#E31A332D" />
            <Setter Property="BorderBrush" Value="#D4A747" />
        </Style>

        <Style Selector="Button.playableTab.active">
            <Setter Property="BorderBrush" Value="#E2BD63" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.playableTab.queued">
            <Setter Property="Background" Value="#D0175C3A" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.familyToggle">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#C00B1C1B" />
            <Setter Property="Foreground" Value="#F1E3C4" />
            <Setter Property="BorderBrush" Value="#8A6728" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.familyToggle:pointerover">
            <Setter Property="Foreground" Value="#FFF1CB" />
            <Setter Property="Background" Value="#D21A332D" />
            <Setter Property="BorderBrush" Value="#D4A747" />
        </Style>

        <Style Selector="Button.familyToggle.active">
            <Setter Property="Background" Value="#B66A4A16" />
            <Setter Property="Foreground" Value="#F1CF78" />
            <Setter Property="BorderBrush" Value="#D5A841" />
        </Style>

        <Style Selector="Button.familyCard">
            <Setter Property="Width" Value="140" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2E6CB" />
            <Setter Property="BorderBrush" Value="#5D4B2D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.familyCard.living">
            <Setter Property="Background" Value="#54000000" />
        </Style>

        <Style Selector="Button.familyCard.deceased">
            <Setter Property="Background" Value="#4D8B622F" />
        </Style>

        <Style Selector="Button.familyCard:pointerover">
            <Setter Property="Foreground" Value="#FFF1CB" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#C99B39" />
        </Style>

        <Style Selector="Button.familyCard.living:pointerover">
            <Setter Property="Background" Value="#54000000" />
        </Style>

        <Style Selector="Button.familyCard.deceased:pointerover">
            <Setter Property="Background" Value="#4D8B622F" />
        </Style>

        <Style Selector="Button.familyCard.selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#D9B04A" />
        </Style>

        <Style Selector="Button.familyCard.living.selected">
            <Setter Property="Background" Value="#54000000" />
        </Style>

        <Style Selector="Button.familyCard.deceased.selected">
            <Setter Property="Background" Value="#4D8B622F" />
        </Style>

        <Style Selector="Button.familyCard.head">
            <Setter Property="BorderBrush" Value="#F2C94C" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="ProgressBar.healthBar">
            <Setter Property="Foreground" Value="#4DAA69" />
            <Setter Property="Background" Value="#48231B1B" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E4D3AE" />
            <Setter Property="Background" Value="#85081312" />
            <Setter Property="Padding" Value="11,4" />
        </Style>

        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#F1CE70" />
            <Setter Property="Background" Value="#A0503213" />
        </Style>
    </Window.Styles>

    <Grid>
        <!-- The start screen uses the Family Tree scenery directly at physical-window size. -->
        <ui:TreeParallaxBackground
            x:Name="MainMenuParallax"
            IsHitTestVisible="False"
            IsVisible="{Binding IsStartScreenVisible}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!-- The original game background is used only after a dynasty has started. -->
        <Image
            IsVisible="{Binding IsGameStarted}"
            Source="/Assets/UI/bg.png"
            Stretch="UniformToFill" />

        <!-- All interface artwork shares one uncropped 16:9 design surface. -->
        <Viewbox
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Grid
                Width="1672"
                Height="941"
                ClipToBounds="True">

                <!-- START SCREEN -->
                <Grid
                    IsVisible="{Binding IsStartScreenVisible}">

                    <Image
                        Width="900"
                        Height="252"
                        Margin="0,28,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Source="/Assets/UI/main_menu_logo.png"
                        Stretch="Uniform" />

                    <Grid
                        Width="760"
                        Height="390"
                        Margin="0,110,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Image
                            Source="/Assets/UI/year_paper.png"
                            Stretch="Fill" />

                        <StackPanel
                            Width="555"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                                FontSize="37"
                                Foreground="#1F160D"
                                Text="Begin a Dynasty" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#49341C"
                                Text="Enter a family surname, or leave it blank for a random one." />

                            <TextBox
                                Height="38"
                                VerticalContentAlignment="Center"
                                Background="#D9F0E2C4"
                                Foreground="#20150B"
                                BorderBrush="#7B5220"
                                BorderThickness="1"
                                PlaceholderText="e.g. Nowak"
                                Text="{Binding SurnameInput, Mode=TwoWay}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#49341C"
                                    Text="{Binding SelectedStartYearText}" />

                                <Slider
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Minimum="1700"
                                    Maximum="2000"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding SelectedStartYear, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="15">

                                <ui:ImageStateButton
                                    Width="205"
                                    Height="71"
                                    IdleSource="avares://Dynastia.App/Assets/UI/b_start_idle.png"
                                    HoverSource="avares://Dynastia.App/Assets/UI/b_start_hover.png"
                                    FallbackText="Start"
                                    Click="OnStartGameClick" />

                                <ui:ImageStateButton
                                    Width="205"
                                    Height="71"
                                    IdleSource="avares://Dynastia.App/Assets/UI/b_load_idle.png"
                                    HoverSource="avares://Dynastia.App/Assets/UI/b_load_hover.png"
                                    FallbackText="Load"
                                    Click="OnLoadGameClick" />
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- MAIN GAME -->
                <Canvas
                    IsVisible="{Binding IsGameStarted}">

                    <!-- Year parchment is deliberately UNDER the Chronicle artwork.
                         Its lower edge is therefore hidden by the Chronicle frame. -->
                    <Image
                        Canvas.Left="1110"
                        Canvas.Top="-62"
                        Width="562"
                        Height="241"
                        IsHitTestVisible="False"
                        Source="/Assets/UI/year_paper.png"
                        Stretch="Fill" />

                    <!-- TOP LEFT — ACTIONS -->
                    <Grid
                        Canvas.Left="8"
                        Canvas.Top="118"
                        Width="820"
                        Height="307.5">

                        <Image
                            IsHitTestVisible="False"
                            Source="/Assets/UI/actions.png"
                            Stretch="Fill" />

                        <Grid
                            Margin="50,76,48,36"
                            RowDefinitions="Auto,*"
                            RowSpacing="9"
                            ClipToBounds="True">

                            <Grid
                                Height="34"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Text="Actions" />

                                <ItemsControl
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ItemsSource="{Binding ActionFilters}">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActionFilterViewModel">
                                            <Button
                                                Margin="6,0,0,0"
                                                Classes="familyToggle"
                                                Classes.active="{Binding IsActive}"
                                                Command="{Binding ToggleCommand}">
                                                <TextBlock
                                                    FontSize="12.5"
                                                    Foreground="#F1E3C4"
                                                    Text="{Binding Label}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">

                                <StackPanel>
                                    <Grid
                                        Margin="0,0,0,7"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="8"
                                        IsVisible="{Binding HasQueuedAction}">

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#E8C96E"
                                            Text="{Binding QueuedActionText}" />

                                        <Button
                                            Grid.Column="1"
                                            Classes="gameAction"
                                            Command="{Binding CancelQueuedActionCommand}">

                                            <TextBlock
                                                Foreground="#F8E9C8"
                                                Text="Cancel" />
                                        </Button>
                                    </Grid>

                                    <TextBlock
                                        Opacity="0.82"
                                        TextWrapping="Wrap"
                                        FontSize="14"
                                        LineHeight="20"
                                        Text="{Binding ActionsEmptyText}" />

                                    <ItemsControl
                                        ItemsSource="{Binding AvailableActions}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate
                                                x:DataType="vm:AvailableActionViewModel">

                                                <Button
                                                    Classes="gameAction"
                                                    Command="{Binding ExecuteCommand}">

                                                    <TextBlock
                                                        FontSize="13.5"
                                                        Foreground="#F8E9C8"
                                                        Text="{Binding Label}" />

                                                    <ToolTip.Tip>
                                                        <Border
                                                            MaxWidth="390"
                                                            Padding="10,7"
                                                            Background="#F20A1514"
                                                            BorderBrush="#B88934"
                                                            BorderThickness="1"
                                                            CornerRadius="4">

                                                            <TextBlock
                                                                FontSize="10.5"
                                                                Foreground="#F5E6C6"
                                                                TextWrapping="Wrap"
                                                                Text="{Binding Description}" />
                                                        </Border>
                                                    </ToolTip.Tip>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- TOP RIGHT — CHRONICLE -->
                    <Grid
                        Canvas.Left="844"
                        Canvas.Top="118"
                        Width="820"
                        Height="307.5">

                        <Image
                            IsHitTestVisible="False"
                            Source="/Assets/UI/chronicle.png"
                            Stretch="Fill" />

                        <Grid
                            Margin="50,76,48,36"
                            RowDefinitions="Auto,*"
                            RowSpacing="9"
                            ClipToBounds="True">

                            <Grid
                                ColumnDefinitions="*,Auto,Auto"
                                ColumnSpacing="7">

                                <TextBlock
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Text="Family Chronicle" />

                                <Button
                                    Grid.Column="1"
                                    Width="68"
                                    Height="34"
                                    Margin="0"
                                    Padding="8,4"
                                    VerticalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Classes="gameAction"
                                    Click="OnMapClick">

                                    <ToolTip.Tip>
                                        <Border
                                            MaxWidth="340"
                                            Padding="10,7"
                                            Background="#F20A1514"
                                            BorderBrush="#B88934"
                                            BorderThickness="1"
                                            CornerRadius="4">

                                            <TextBlock
                                                FontSize="10.5"
                                                LineHeight="17"
                                                Foreground="#F5E6C6"
                                                TextWrapping="Wrap"
                                                Text="Open the dynasty map. Scroll to zoom, drag to pan, hover over towns, and click a town to inspect family presence and property." />
                                        </Border>
                                    </ToolTip.Tip>

                                    <TextBlock
                                        Foreground="#F8E9C8"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Text="Map" />
                                </Button>

                                <Grid
                                    Grid.Column="2"
                                    Width="132"
                                    Height="34"
                                    VerticalAlignment="Center"
                                    ColumnDefinitions="40,52,40">

                                    <Button
                                        Grid.Column="0"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        Classes="gameAction"
                                        Command="{Binding PreviousAlbumYearCommand}">

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="#F8E9C8"
                                            Text="‹" />
                                    </Button>

                                    <Button
                                        Grid.Column="1"
                                        Margin="0"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ShowAlbumYearSummaryCommand}">

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextAlignment="Center"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#DDB64E"
                                            Text="{Binding AlbumDisplayYear}" />
                                    </Button>

                                    <Button
                                        Grid.Column="2"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        Classes="gameAction"
                                        Command="{Binding NextAlbumYearCommand}">

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="#F8E9C8"
                                            Text="›" />
                                    </Button>
                                </Grid>
                            </Grid>

                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">

                                <Grid>
                                    <TextBlock
                                        Opacity="0.67"
                                        FontStyle="Italic"
                                        FontSize="13"
                                        Text="{Binding AlbumEmptyText}" />

                                    <ItemsControl
                                        ItemsSource="{Binding AlbumEvents}">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate
                                                x:DataType="vm:AlbumEventViewModel">

                                                <TextBlock
                                                    Margin="0,3,0,6"
                                                    FontSize="16"
                                                    LineHeight="23"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding Text}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- BOTTOM LEFT — HOUSEHOLDS, exact 8:5 -->
                    <Grid
                        Canvas.Left="8"
                        Canvas.Top="420"
                        Width="820"
                        Height="512.5"
                        ClipToBounds="True">

                        <Image
                            IsHitTestVisible="False"
                            Source="/Assets/UI/households.png"
                            Stretch="Fill" />

                        <Grid
                            Margin="54,58,49,46"
                            RowDefinitions="Auto,*"
                            RowSpacing="8">

                            <Grid
                                ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto"
                                ColumnSpacing="7">

                                <TextBlock
                                    Margin="7,4,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Text="Households" />

                                <Button
                                    Grid.Column="1"
                                    Margin="16,7,8,0"
                                    Padding="12,6"
                                    MinWidth="96"
                                    FontSize="13.5"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Classes="gameAction"
                                    Click="OnViewTreeClick">

                                    <ToolTip.Tip>
                                        <Border
                                            MaxWidth="390"
                                            Padding="10,7"
                                            Background="#F20A1514"
                                            BorderBrush="#B88934"
                                            BorderThickness="1"
                                            CornerRadius="4">

                                            <TextBlock
                                                FontSize="10.5"
                                                LineHeight="17"
                                                Foreground="#F5E6C6"
                                                TextWrapping="Wrap"
                                                Text="Open the full genealogy tree. Scroll to zoom, drag to pan, and click a person to select them." />
                                        </Border>
                                    </ToolTip.Tip>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        FontSize="13.5"
                                        Foreground="#F8E9C8"
                                        Text="View Tree" />
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    Margin="0,7,8,0"
                                    Padding="12,6"
                                    MinWidth="96"
                                    FontSize="13.5"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Classes="gameAction"
                                    IsVisible="{Binding HasFamilyRelations}"
                                    Click="OnRelationsClick">

                                    <ToolTip.Tip>
                                        <Border
                                            MaxWidth="390"
                                            Padding="10,7"
                                            Background="#F20A1514"
                                            BorderBrush="#B88934"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontSize="10.5"
                                                LineHeight="17"
                                                Foreground="#F5E6C6"
                                                TextWrapping="Wrap"
                                                Text="Open persistent relationships with parents, siblings, adult children and former spouses." />
                                        </Border>
                                    </ToolTip.Tip>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        TextAlignment="Center"
                                        FontSize="13.5"
                                        Foreground="#F8E9C8"
                                        Text="Relations" />
                                </Button>

                                <Button
                                    Grid.Column="4"
                                    Margin="0,8,5,0"
                                    Classes="familyToggle"
                                    Classes.active="{Binding IsLineageFamilyView}"
                                    Command="{Binding ShowLivingFamilyCommand}">

                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="#F1E3C4"
                                        Text="Lineage" />
                                </Button>

                                <Button
                                    Grid.Column="5"
                                    Margin="0,8,5,0"
                                    Classes="familyToggle"
                                    Classes.active="{Binding IsBloodlineFamilyView}"
                                    Command="{Binding ShowBloodlineFamilyCommand}">

                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="#F1E3C4"
                                        Text="Bloodline" />
                                </Button>

                                <Button
                                    Grid.Column="6"
                                    Margin="0,8,18,0"
                                    Classes="familyToggle"
                                    Classes.active="{Binding IsDeceasedFamilyView}"
                                    Command="{Binding ShowDeceasedFamilyCommand}">

                                    <TextBlock
                                        FontSize="12.5"
                                        Foreground="#F1E3C4"
                                        Text="Deceased" />
                                </Button>
                            </Grid>

                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">

                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                    <ItemsControl
                                        Grid.Row="0"
                                        IsVisible="{Binding IsLineageFamilyView}"
                                        ItemsSource="{Binding PlayableTabs}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PlayablePersonTabViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="#B79A5D"
                                                        Text="{Binding GenerationText}" />

                                                    <Button
                                                        Classes="playableTab"
                                                        Classes.active="{Binding IsActive}"
                                                        Classes.queued="{Binding HasQueuedAction}"
                                                        Command="{Binding SwitchCommand}">
                                                        <ToolTip.Tip>
                                                            <Border
                                                                MaxWidth="390"
                                                                Padding="10,7"
                                                                Background="#F20A1514"
                                                                BorderBrush="#B88934"
                                                                BorderThickness="1"
                                                                CornerRadius="4">
                                                                <TextBlock
                                                                    FontSize="10.5"
                                                                    LineHeight="17"
                                                                    Foreground="#F5E6C6"
                                                                    TextWrapping="Wrap"
                                                                    Text="{Binding ActionSummaryText}" />
                                                            </Border>
                                                        </ToolTip.Tip>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontSize="13.5"
                                                            Foreground="#F4E8CB"
                                                            Text="{Binding Label}" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl
                                        Grid.Row="0"
                                        IsVisible="{Binding IsBloodlineFamilyView}"
                                        ItemsSource="{Binding BloodlineTabs}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PlayablePersonTabViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="#B79A5D"
                                                        Text="{Binding GenerationText}" />

                                                    <Button
                                                        Classes="playableTab"
                                                        Classes.active="{Binding IsActive}"
                                                        Classes.queued="{Binding HasQueuedAction}"
                                                        Command="{Binding SwitchCommand}">
                                                        <ToolTip.Tip>
                                                            <Border
                                                                MaxWidth="390"
                                                                Padding="10,7"
                                                                Background="#F20A1514"
                                                                BorderBrush="#B88934"
                                                                BorderThickness="1"
                                                                CornerRadius="4">
                                                                <TextBlock
                                                                    FontSize="10.5"
                                                                    LineHeight="17"
                                                                    Foreground="#F5E6C6"
                                                                    TextWrapping="Wrap"
                                                                    Text="{Binding ActionSummaryText}" />
                                                            </Border>
                                                        </ToolTip.Tip>
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            FontSize="13.5"
                                                            Foreground="#F4E8CB"
                                                            Text="{Binding Label}" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel
                                        Grid.Row="1"
                                        IsVisible="{Binding IsLivingFamilyView}"
                                        HorizontalAlignment="Center"
                                        Spacing="4"
                                        PointerPressed="OnFamilyInventoryClick">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#E3C36D"
                                            Text="{Binding HouseholdBudgetText}" />

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="#E8DDC2"
                                            Text="{Binding HouseholdLastYearText}">
                                            <ToolTip.Tip>
                                                <Border
                                                    MaxWidth="390"
                                                    Padding="10,7"
                                                    Background="#F20A1514"
                                                    BorderBrush="#B88934"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        FontSize="11"
                                                        LineHeight="17"
                                                        Foreground="#F5E6C6"
                                                        TextWrapping="Wrap"
                                                        Text="{Binding HouseholdLastYearDetailsText}" />
                                                </Border>
                                            </ToolTip.Tip>
                                        </TextBlock>

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12.5"
                                            FontWeight="Bold"
                                            Foreground="#D5B45D"
                                            Text="{Binding HouseholdHousesText}">
                                            <ToolTip.Tip>
                                                <Border
                                                    MaxWidth="360"
                                                    Padding="10,7"
                                                    Background="#F20A1514"
                                                    BorderBrush="#B88934"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        FontSize="11"
                                                        LineHeight="17"
                                                        Foreground="#F5E6C6"
                                                        TextWrapping="Wrap"
                                                        Text="{Binding HouseholdHousesDetailsText}" />
                                                </Border>
                                            </ToolTip.Tip>
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <StackPanel
                                            IsVisible="{Binding IsLivingFamilyView}"
                                            Spacing="4">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Foreground="#E1B546"
                                                Text="{Binding HouseholdWarningText}" />

                                            <ItemsControl
                                                HorizontalAlignment="Center"
                                                ItemsSource="{Binding HouseholdMembers}"
                                                ItemTemplate="{StaticResource FamilyCardTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel
                                            IsVisible="{Binding IsDeceasedFamilyView}"
                                            Spacing="6">
                                            <ItemsControl
                                                HorizontalAlignment="Center"
                                                ItemsSource="{Binding DeceasedFamilyMembers}"
                                                ItemTemplate="{StaticResource FamilyCardTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="8.5"
                                                Opacity="0.55"
                                                Text="{Binding DeceasedFamilyEmptyText}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- BOTTOM RIGHT — PERSONAL, exact same 8:5 size -->
                    <Grid
                        Canvas.Left="844"
                        Canvas.Top="420"
                        Width="820"
                        Height="512.5"
                        ClipToBounds="True">

                        <Image
                            IsHitTestVisible="False"
                            Source="/Assets/UI/personal.png"
                            Stretch="Fill" />

                        <!-- Portrait -->
                        <Border
                            Margin="49,121,0,0"
                            Width="135"
                            Height="202"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#54000000"
                            BorderBrush="#9D772E"
                            BorderThickness="1.5"
                            CornerRadius="4">

                            <Grid>
                                <TextBlock
                                    Margin="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    FontSize="84"
                                    Text="{Binding SelectedPersonPortrait}" />

                                <Border
                                    IsVisible="{Binding IsSelectedPersonDeceased}"
                                    IsHitTestVisible="False"
                                    Background="#5A8B622F"
                                    CornerRadius="3" />
                            </Grid>
                        </Border>

                        <!-- Name sits directly above the portrait frame. -->
                        <TextBlock
                            Margin="49,58,0,0"
                            Width="340"
                            Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            TextAlignment="Left"
                            FontSize="28"
                            FontWeight="Bold"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis"
                            Text="{Binding SelectedPerson.FullName,
                                       FallbackValue='Select a person'}" />

                        <TextBlock
                            Margin="49,94,0,0"
                            Width="140"
                            Height="17"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            FontSize="12"
                            FontStyle="Italic"
                            Foreground="#BFAE8B"
                            TextTrimming="CharacterEllipsis"
                            IsVisible="{Binding SelectedPerson.HasPersonality}"
                            Text="{Binding SelectedPerson.PersonalityText}" />

                        <!-- Six larger, color-coded skills. -->
                        <Border
                            Margin="0,54,46,0"
                            Width="384"
                            Height="62"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Padding="6,4"
                            Background="#54000000"
                            CornerRadius="6">
                            <ItemsControl
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding SelectedStats}"
                                ItemTemplate="{StaticResource CompactStatTemplate}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>

                        <!-- Health -->
                        <StackPanel
                            Margin="196,122,38,0"
                            Height="48"
                            VerticalAlignment="Top"
                            Spacing="4"
                            IsVisible="{Binding SelectedPerson.ShowHealth}">

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                FontWeight="Bold"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                Text="{Binding SelectedHealth.HealthSummaryText}" />

                            <ProgressBar
                                Classes="healthBar"
                                Margin="0,3,0,0"
                                Height="10"
                                Minimum="0"
                                Maximum="100"
                                Foreground="{Binding SelectedHealth.Percentage,
                                                     Converter={StaticResource HealthBrushConverter}}"
                                Value="{Binding SelectedHealth.Percentage}" />
                        </StackPanel>

                        <!-- Personal tabs are explicitly clipped to the frame. -->
                        <TabControl
                            Margin="202,167,40,54"
                            ClipToBounds="True"
                            SelectedIndex="{Binding DetailsTabIndex, Mode=TwoWay}">

                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock
                                        Foreground="#E9D8B3"
                                        Text="General" />
                                </TabItem.Header>
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">

                                    <Grid
                                        Margin="9"
                                        RowDefinitions="*"
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="18"
                                        RowSpacing="5">

                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Spacing="4">

                                            <TextBlock IsVisible="{Binding SelectedFamily.HasStatus}" FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedFamily.Renown}" />
                                            <TextBlock IsVisible="{Binding SelectedFamily.HasStatus}" FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedFamily.Reputation}" />
                                            <TextBlock IsVisible="{Binding SelectedPerson.ShowLearningDetails}" FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedEducation.EducationText}" />
                                            <TextBlock IsVisible="{Binding SelectedPerson.ShowLearningDetails}" FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedHobbiesText}" />
                                            <TextBlock IsVisible="{Binding SelectedPerson.ShowLearningDetails}" FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedEducation.CraftsText}" />
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedCareer.OccupationText}" />
                                            <TextBlock
                                                IsVisible="{Binding SelectedCareer.HasSatisfaction}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"
                                                Foreground="{Binding SelectedCareer.SatisfactionLabel,
                                                                     Converter={StaticResource SatisfactionBrushConverter}}"
                                                Text="{Binding SelectedCareer.SatisfactionText}" />

                                            <TextBlock
                                                IsVisible="{Binding HasSelectedMarriageSatisfaction}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"
                                                Foreground="{Binding SelectedMarriageSatisfactionLabel,
                                                                     Converter={StaticResource SatisfactionBrushConverter}}"
                                                Text="{Binding SelectedMarriageSatisfactionText}">

                                                <ToolTip.Tip>
                                                    <Border
                                                        MaxWidth="330"
                                                        Padding="10,7"
                                                        Background="#F20A1514"
                                                        BorderBrush="#B88934"
                                                        BorderThickness="1"
                                                        CornerRadius="4">

                                                        <TextBlock
                                                            FontSize="11"
                                                            LineHeight="17"
                                                            Foreground="#F5E6C6"
                                                            TextWrapping="Wrap"
                                                            Text="{Binding SelectedMarriageSatisfactionDetailsText}" />
                                                    </Border>
                                                </ToolTip.Tip>
                                            </TextBlock>

                                            <TextBlock
                                                IsVisible="{Binding HasSelectedChildHappiness}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap"
                                                Foreground="{Binding SelectedChildHappinessLabel, Converter={StaticResource SatisfactionBrushConverter}}"
                                                Text="{Binding SelectedChildHappinessText}" />

                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedCareer.IncomeText}" />
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedJustice.StatusText}" />
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedJustice.CrimeText}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Spacing="2">

                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedPerson.AgeText}" />
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedFamily.Sex, StringFormat='Sex: {0}'}" />
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding SelectedPerson.NationalityText}" />

                                            <TextBlock
                                                FontSize="12"
                                                Text="{Binding SelectedPerson.BirthDateText}" />

                                            <TextBlock
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                Text="{Binding SelectedPerson.BirthplaceText}" />

                                            <TextBlock
                                                IsVisible="{Binding SelectedPerson.HasResidence}"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                Text="{Binding SelectedPerson.ResidenceText}" />

                                            <TextBlock
                                                IsVisible="{Binding SelectedPerson.HasDeathDate}"
                                                FontSize="12"
                                                Text="{Binding SelectedPerson.DeathDateText}" />

                                            <TextBlock
                                                IsVisible="{Binding SelectedPerson.HasDeathplace}"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                Text="{Binding SelectedPerson.DeathplaceText}" />

                                            <TextBlock
                                                IsVisible="{Binding SelectedPerson.HasMaidenName}"
                                                FontSize="12"
                                                Text="{Binding SelectedPerson.MaidenNameText}" />

                                            <TextBlock
                                                IsVisible="{Binding SelectedPerson.HasOrphanTrait}"
                                                FontSize="12"
                                                Text="{Binding SelectedPerson.OrphanTraitText}" />

                                            <TextBlock
                                                FontSize="12"
                                                Text="{Binding SelectedFamily.Generation, StringFormat='Generation: {0}'}" />

                                            <TextBlock
                                                FontSize="12"
                                                Text="{Binding SelectedFamily.Bloodline, StringFormat='Bloodline: {0}'}" />

                                            <TextBlock
                                                FontSize="12"
                                                Text="{Binding SelectedFamily.MaleLineage, StringFormat='Male lineage: {0}'}" />

                                        </StackPanel>

                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock
                                        Foreground="#E9D8B3"
                                        Text="About" />
                                </TabItem.Header>
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">

                                    <TextBlock
                                        Margin="9"
                                        FontSize="12"
                                        LineHeight="18"
                                        TextWrapping="Wrap"
                                        Text="{Binding SelectedAboutText}" />
                                </ScrollViewer>
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock
                                        Foreground="#E9D8B3"
                                        Text="Relationships" />
                                </TabItem.Header>
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">

                                    <Grid
                                        Margin="9"
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="18">

                                        <ItemsControl
                                            Grid.Column="0"
                                            ItemsSource="{Binding SelectedFamily.RelationshipPeople}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RelationshipPersonLineViewModel">
                                                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                                                        <TextBlock
                                                            FontSize="12"
                                                            Text="{Binding Label, StringFormat='{}{0}: '}" />
                                                        <Button
                                                            Grid.Column="1"
                                                            Classes="relationshipLink"
                                                            IsVisible="{Binding IsSelectable}"
                                                            Click="OnRelationshipPersonClick">
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="#E9D8B3"
                                                                Text="{Binding DisplayText}" />
                                                        </Button>
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            IsVisible="{Binding IsPlainText}"
                                                            FontSize="12"
                                                            Foreground="#A99D86"
                                                            Text="{Binding DisplayText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel
                                            Grid.Column="1"
                                            IsVisible="{Binding SelectedFamily.ShowAdultRelationships}"
                                            Spacing="4">

                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="#D7B65B"
                                                Text="Relationship history" />

                                            <TextBlock
                                                IsVisible="{Binding SelectedFamily.ShowRelationshipHistoryEmptyText}"
                                                FontSize="11.5"
                                                Opacity="0.65"
                                                Text="{Binding SelectedFamily.RelationshipHistoryEmptyText}" />

                                            <ItemsControl ItemsSource="{Binding SelectedFamily.RelationshipHistoryItems}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RelationshipHistoryLineViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="0" Margin="0,0,0,4">
                                                            <TextBlock
                                                                FontSize="11.5"
                                                                Text="{Binding PeriodText}" />
                                                            <Button
                                                                Classes="relationshipLink"
                                                                IsVisible="{Binding IsSelectable}"
                                                                Click="OnRelationshipPersonClick">
                                                                <TextBlock
                                                                    FontSize="11.5"
                                                                    Foreground="#E9D8B3"
                                                                    Text="{Binding PersonText}" />
                                                            </Button>
                                                            <TextBlock
                                                                IsVisible="{Binding IsPlainText}"
                                                                FontSize="11.5"
                                                                Foreground="#A99D86"
                                                                Text="{Binding PersonText}" />
                                                            <TextBlock
                                                                FontSize="11.5"
                                                                Text="{Binding ReasonText}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem>
                                <TabItem.Header>
                                    <TextBlock
                                        Foreground="#E9D8B3"
                                        Text="Biography" />
                                </TabItem.Header>
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">

                                    <Grid Margin="9">

                                        <TextBlock
                                            FontSize="11.5"
                                            Opacity="0.6"
                                            Text="{Binding BiographyEmptyText}" />

                                        <ItemsControl
                                            ItemsSource="{Binding SelectedBiography}">

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate
                                                    x:DataType="vm:BiographyEntryViewModel">

                                                    <Grid
                                                        Margin="0,0,0,5"
                                                        ColumnDefinitions="42,*"
                                                        ColumnSpacing="6">

                                                        <TextBlock
                                                            FontSize="11.5"
                                                            FontWeight="Bold"
                                                            Foreground="#D7B65B"
                                                            Text="{Binding Year}" />

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="11.5"
                                                            LineHeight="17"
                                                            TextWrapping="Wrap"
                                                            Text="{Binding Message}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <!-- HEADER -->
                    <Image
                        Canvas.Left="18"
                        Canvas.Top="5"
                        Width="185"
                        Height="185"
                        IsHitTestVisible="False"
                        Source="/Assets/UI/coat_of_arms.png"
                        Stretch="Uniform" />

                    <TextBlock
                        Canvas.Left="218"
                        Canvas.Top="49"
                        Width="480"
                        FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                        FontSize="46"
                        Foreground="#DDB64E"
                        Text="{Binding DynastyTitle}" />


                    <Canvas
                        Canvas.Left="744"
                        Canvas.Top="10"
                        Width="364"
                        Height="112">

                        <ui:ImageStateButton
                            Canvas.Left="40"
                            Canvas.Top="0"
                            Width="156"
                            Height="52"
                            IdleSource="avares://Dynastia.App/Assets/UI/b_menu_idle.png"
                            HoverSource="avares://Dynastia.App/Assets/UI/b_menu_hover.png"
                            FallbackText="Main Menu"
                            Command="{Binding ShowMainMenuPromptCommand}" />

                        <ui:ImageStateButton
                            Canvas.Left="198"
                            Canvas.Top="0"
                            Width="166"
                            Height="52"
                            IdleSource="avares://Dynastia.App/Assets/UI/b_instructions_idle.png"
                            HoverSource="avares://Dynastia.App/Assets/UI/b_instructions_hover.png"
                            FallbackText="Instructions"
                            Click="OnInstructionsClick" />

                        <ui:ImageStateButton
                            Canvas.Left="40"
                            Canvas.Top="58"
                            Width="156"
                            Height="52"
                            IdleSource="avares://Dynastia.App/Assets/UI/b_load_idle.png"
                            HoverSource="avares://Dynastia.App/Assets/UI/b_load_hover.png"
                            FallbackText="Load"
                            Click="OnLoadGameClick" />

                        <ui:ImageStateButton
                            Canvas.Left="198"
                            Canvas.Top="58"
                            Width="166"
                            Height="52"
                            IdleSource="avares://Dynastia.App/Assets/UI/b_export_idle.png"
                            HoverSource="avares://Dynastia.App/Assets/UI/b_export_hover.png"
                            FallbackText="Export"
                            Click="OnSaveGameClick" />
                    </Canvas>

                    <Button
                        x:Name="MusicToggleButton"
                        Canvas.Left="1150"
                        Canvas.Top="11"
                        Width="28"
                        Height="28"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#72000000"
                        BorderBrush="#8F6C2C"
                        BorderThickness="1"
                        CornerRadius="4"
                        Foreground="#17110C"
                        FontSize="15"
                        Content="🔊"
                        Click="OnMusicToggleClick">
                        <ToolTip.Tip>
                            <TextBlock
                                Foreground="#17110C"
                                Text="Mute music" />
                        </ToolTip.Tip>
                    </Button>

                    <TextBlock
                        Canvas.Left="1158"
                        Canvas.Top="10"
                        Width="158"
                        Height="34"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        LineHeight="15"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#392817"
                        Text="{Binding HistoricalEraName}" />

                    <TextBlock
                        Canvas.Left="1166"
                        Canvas.Top="45"
                        Width="150"
                        TextAlignment="Center"
                        FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                        FontSize="53"
                        Foreground="#17110C"
                        Text="{Binding Year}" />

                    <ui:ImageStateButton
                        Canvas.Left="1322"
                        Canvas.Top="15"
                        Width="314"
                        Height="105"
                        IdleSource="avares://Dynastia.App/Assets/UI/next_year_idle.png"
                        HoverSource="avares://Dynastia.App/Assets/UI/next_year_hover.png"
                        FallbackText="Next Year"
                        Command="{Binding NextYearCommand}" />
                </Canvas>

                <!-- STATUS MESSAGE -->
                <Grid
                    IsVisible="{Binding IsStatusMessageVisible}"
                    Background="#A8000000">

                    <Grid
                        Width="700"
                        Height="290"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Image
                            Source="/Assets/UI/year_paper.png"
                            Stretch="Fill" />

                        <StackPanel
                            Width="500"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                                FontSize="36"
                                Foreground="#301E0E"
                                Text="Dynastia" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                FontSize="16"
                                Foreground="#362616"
                                Text="{Binding PersistenceStatusText}" />

                            <ui:ImageStateButton
                                Width="172"
                                Height="56"
                                HorizontalAlignment="Center"
                                IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                                HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                                FallbackText="Close"
                                Command="{Binding HideStatusMessageCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- BACKDROP FOR BORDERLESS PAPER DIALOGS -->
                <Grid
                    x:Name="PaperDialogBackdrop"
                    IsVisible="False"
                    IsHitTestVisible="True"
                    Background="#A8000000" />

                <!-- MAIN MENU PROMPT -->
                <Grid
                    IsVisible="{Binding IsMainMenuPromptVisible}"
                    Background="#A8000000">

                    <Grid
                        Width="760"
                        Height="390"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Image
                            Source="/Assets/UI/year_paper.png"
                            Stretch="Fill" />

                        <StackPanel
                            Width="560"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14">

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                                FontSize="38"
                                Foreground="#301E0E"
                                Text="Main Menu" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                FontSize="15"
                                Foreground="#362616"
                                Text="Do you want to return to the main menu now, or export your dynasty first?" />

                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="12">

                                <ui:ImageStateButton
                                    Width="172"
                                    Height="56"
                                    IdleSource="avares://Dynastia.App/Assets/UI/b_menu_idle.png"
                                    HoverSource="avares://Dynastia.App/Assets/UI/b_menu_hover.png"
                                    FallbackText="Main Menu"
                                    Command="{Binding ReturnToMainMenuCommand}" />

                                <ui:ImageStateButton
                                    Width="172"
                                    Height="56"
                                    IdleSource="avares://Dynastia.App/Assets/UI/b_export_idle.png"
                                    HoverSource="avares://Dynastia.App/Assets/UI/b_export_hover.png"
                                    FallbackText="Export"
                                    Click="OnSaveGameClick" />

                                <ui:ImageStateButton
                                    Width="172"
                                    Height="56"
                                    IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                                    HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                                    FallbackText="Close"
                                    Command="{Binding HideMainMenuPromptCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- YEAR SUMMARY -->
                <Grid
                    IsVisible="{Binding IsYearSummaryVisible}"
                    Background="#B0000000">

                    <Grid
                        Width="1000"
                        Height="760"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Image
                            Source="/Assets/UI/instructions_paper.png"
                            Stretch="Fill" />

                        <Grid
                            Margin="80,72,80,58"
                            RowDefinitions="Auto,Auto,*,Auto"
                            RowSpacing="12">

                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="14">
                                <Button
                                    Grid.Column="0"
                                    Width="46"
                                    Height="38"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Classes="gameAction"
                                    Command="{Binding PreviousYearSummaryCommand}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="21"
                                        Foreground="#F8E9C8"
                                        Text="&lt;" />
                                </Button>

                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                                    FontSize="42"
                                    Foreground="#2F1D0E"
                                    Text="{Binding YearSummaryTitle}" />

                                <Button
                                    Grid.Column="2"
                                    Width="46"
                                    Height="38"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Classes="gameAction"
                                    Command="{Binding NextYearSummaryCommand}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="21"
                                        Foreground="#F8E9C8"
                                        Text="&gt;" />
                                </Button>
                            </Grid>

                            <TextBlock
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                FontFamily="Georgia"
                                FontSize="14"
                                Foreground="#5B4024"
                                Text="Global news and notable family events." />

                            <Border
                                Grid.Row="2"
                                Padding="8"
                                Background="#0FFFFFFF"
                                BorderBrush="#8F6A34"
                                BorderThickness="1.5"
                                CornerRadius="6">

                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">

                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Opacity="0.7"
                                            FontFamily="Georgia"
                                            FontStyle="Italic"
                                            FontSize="15"
                                            Foreground="#362616"
                                            Text="{Binding YearSummaryEmptyText}" />

                                        <ItemsControl
                                            ItemsSource="{Binding YearSummaryHouseholds}">

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate
                                                    x:DataType="vm:YearSummaryHouseholdViewModel">

                                                    <Border
                                                        Margin="6,5"
                                                        Padding="16,13"
                                                        Background="#35FFF4D9"
                                                        BorderBrush="#A17A43"
                                                        BorderThickness="1"
                                                        CornerRadius="4">

                                                        <StackPanel Spacing="7">
                                                            <TextBlock
                                                                FontFamily="Georgia"
                                                                FontSize="18"
                                                                FontWeight="Bold"
                                                                Foreground="#352110"
                                                                Text="{Binding Title}" />

                                                            <ItemsControl
                                                                ItemsSource="{Binding Events}">

                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate
                                                                        x:DataType="vm:AlbumEventViewModel">

                                                                        <TextBlock
                                                                            Margin="10,2,0,3"
                                                                            FontFamily="Georgia"
                                                                            FontSize="16"
                                                                            LineHeight="23"
                                                                            Foreground="#46321C"
                                                                            TextWrapping="Wrap"
                                                                            Text="{Binding Text}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <Grid
                                Grid.Row="3"
                                Margin="4,0">
                                <ui:ImageStateButton
                                    Width="170"
                                    Height="70"
                                    HorizontalAlignment="Right"
                                    IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                                    HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                                    FallbackText="Close"
                                    Command="{Binding HideYearSummaryCommand}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- GAME OVER -->
                <Grid
                    IsVisible="{Binding IsGameOverOverlayVisible}"
                    Background="#A8000000">

                    <Grid
                        Width="720"
                        Height="330"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Image
                            Source="/Assets/UI/year_paper.png"
                            Stretch="Fill" />

                        <StackPanel
                            Width="480"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">

                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                                FontSize="40"
                                Foreground="#301E0E"
                                Text="{Binding GameOverTitle}" />

                            <TextBlock
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                FontSize="15"
                                Foreground="#362616"
                                Text="{Binding GameOverText}" />

                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="12">

                                <ui:ImageStateButton
                                    Width="172"
                                    Height="56"
                                    IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                                    HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                                    FallbackText="Close"
                                    Command="{Binding GoBackFromGameOverCommand}" />

                                <ui:ImageStateButton
                                    Width="172"
                                    Height="56"
                                    IdleSource="avares://Dynastia.App/Assets/UI/b_menu_idle.png"
                                    HoverSource="avares://Dynastia.App/Assets/UI/b_menu_hover.png"
                                    FallbackText="Main Menu"
                                    Command="{Binding ReturnToMainMenuCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
