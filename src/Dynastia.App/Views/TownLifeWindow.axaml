<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:Dynastia.Contracts"
    xmlns:controls="using:Dynastia.App.Controls"
    x:Class="Dynastia.App.Views.TownLifeWindow"
    x:DataType="contracts:TownLifeSnapshot"
    Width="960"
    Height="760"
    MinWidth="960"
    MinHeight="760"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    Title="Town / City Affairs"
    KeyDown="OnKeyDown">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="Foreground" Value="#352110" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#5A3A18" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#654621" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Background" Value="#35FFF4D9" />
            <Setter Property="BorderBrush" Value="#A17A43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.closeButton">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="#E6D2AA" />
            <Setter Property="Foreground" Value="#3A2413" />
            <Setter Property="BorderBrush" Value="#93662F" />
            <Setter Property="BorderThickness" Value="1.3" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image Source="/Assets/UI/instructions_paper.png" Stretch="Fill" />

        <Grid Margin="70,58,70,46" RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                FontSize="38"
                Foreground="#2F1D0E"
                Text="{Binding NavigationLabel}" />

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="5*,6*" ColumnSpacing="10">
                        <Border Classes="section">
                            <StackPanel Spacing="7">
                                <TextBlock Classes="sectionHeader" Text="{Binding Town.Town}" />
                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
                                    <TextBlock Classes="label" Text="Region" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding RegionName}" />
                                    <TextBlock Grid.Row="1" Classes="label" Text="Population" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding PopulationText}" />
                                    <TextBlock Grid.Row="2" Classes="label" Text="Settlement" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding Town.SettlementClassDisplayName}" />
                                    <TextBlock Grid.Row="3" Classes="label" Text="Polity" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding Town.PolityName}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="section">
                            <StackPanel Spacing="5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="sectionHeader" Text="Local Economy" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                                        <TextBlock FontSize="19" FontWeight="Bold" Foreground="#7A561E" Text="{Binding Prosperity.Index}" />
                                        <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Text="{Binding Prosperity.Label}" />
                                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Prosperity.TrendText}" />
                                    </StackPanel>
                                </Grid>

                                <controls:TownProsperityGraph
                                    Height="92"
                                    History="{Binding Prosperity.HistoryPoints}" />

                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3">
                                    <TextBlock Classes="label" Text="Trend years" />
                                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding Prosperity.HistoryRangeText}" />
                                    <TextBlock Grid.Row="1" Classes="label" Text="Strong fields" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding LocalOpportunityText}" />
                                    <TextBlock Grid.Row="2" Classes="label" Text="Regional support" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding RegionalOpportunityText}" />
                                    <TextBlock Grid.Row="3" Classes="label" Text="Shocks" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding Prosperity.ActiveShocksText}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Classes="section">
                        <StackPanel Spacing="7">
                            <TextBlock Classes="sectionHeader" Text="Institutions" />

                            <ItemsControl ItemsSource="{Binding InstitutionCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="contracts:TownInstitutionAffairsInfo">
                                        <Border
                                            Margin="0,3"
                                            Padding="10,7"
                                            Background="#25FFF4D9"
                                            BorderBrush="#7E623D"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Grid ColumnDefinitions="58,190,*" ColumnSpacing="11">
                                                <Border
                                                    Width="48"
                                                    Height="48"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#54000000"
                                                    BorderBrush="#8A6435"
                                                    BorderThickness="1.5"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center"
                                                        FontSize="28"
                                                        Text="{Binding Emoji}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock
                                                        FontSize="14.5"
                                                        FontWeight="Bold"
                                                        Text="{Binding DisplayName}" />
                                                    <TextBlock
                                                        FontSize="11.5"
                                                        Foreground="#654621"
                                                        Text="{Binding Summary}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock
                                                        Classes="value"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding ServiceText}" />
                                                    <TextBlock
                                                        Classes="value"
                                                        Text="{Binding CareerText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button
                Grid.Row="2"
                HorizontalAlignment="Center"
                Classes="closeButton"
                Click="OnCloseClick"
                Content="Close" />
        </Grid>
    </Grid>
</Window>
