<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Dynastia.App.Controls"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    xmlns:vm="using:Dynastia.App.ViewModels"
    xmlns:contracts="using:Dynastia.Contracts"
    x:Class="Dynastia.App.Views.TownLifeWindow"
    x:DataType="vm:TownAffairsViewModel"
    Width="1000"
    Height="800"
    MinWidth="1000"
    MinHeight="800"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    Title="Town / City Affairs"
    KeyDown="OnKeyDown">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="Foreground" Value="#352110" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#5A3A18" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#654621" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="#35FFF4D9" />
            <Setter Property="BorderBrush" Value="#A17A43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.paperAction">
            <Setter Property="MinWidth" Value="105" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#E6D2AA" />
            <Setter Property="Foreground" Value="#3A2413" />
            <Setter Property="BorderBrush" Value="#93662F" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.memberTab">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#EAD9B6" />
            <Setter Property="Foreground" Value="#3A2413" />
            <Setter Property="BorderBrush" Value="#93662F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.memberTab:disabled">
            <Setter Property="Background" Value="#C9A96C" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image Source="/Assets/UI/instructions_paper.png" Stretch="Fill" />

        <Grid Margin="66,48,66,38" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
            <StackPanel HorizontalAlignment="Center" Spacing="0">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                    FontSize="34"
                    Foreground="#2F1D0E"
                    Text="{Binding Snapshot.NavigationLabel}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="5*,6*" ColumnSpacing="10">
                <Border Classes="section">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#5A3A18"
                            Text="{Binding Snapshot.Town.Town}" />
                        <Grid ColumnDefinitions="104,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Classes="label" FontSize="14.5" Text="Polity" />
                            <TextBlock Grid.Column="1" Classes="value" FontSize="14.5" Text="{Binding Snapshot.Town.PolityName}" />
                            <TextBlock Grid.Row="1" Classes="label" FontSize="14.5" Text="Region" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" FontSize="14.5" Text="{Binding Snapshot.RegionName}" />
                            <TextBlock Grid.Row="2" Classes="label" FontSize="14.5" Text="Settlement" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" FontSize="14.5" Text="{Binding Snapshot.Town.SettlementClassDisplayName}" />
                            <TextBlock Grid.Row="3" Classes="label" FontSize="14.5" Text="Population" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" FontSize="14.5" Text="{Binding Snapshot.PopulationText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="section">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="sectionHeader" Text="Local Economy" />
                            <TextBlock FontSize="19" FontWeight="Bold" Foreground="{Binding ProsperityBrush}" Text="{Binding Snapshot.Prosperity.Index}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{Binding ProsperityBrush}" Text="{Binding Snapshot.Prosperity.Label}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{Binding ProsperityBrush}" Text="{Binding Snapshot.Prosperity.TrendText}" />
                        </StackPanel>
                        <controls:TownProsperityGraph Height="68" History="{Binding Snapshot.Prosperity.HistoryPoints}" />
                        <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                            <TextBlock Classes="label" Text="Strong fields" />
                            <TextBlock Grid.Column="1" Classes="value" Text="{Binding Snapshot.LocalOpportunityText}" />
                            <TextBlock Grid.Row="1" Classes="label" Text="Regional support" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding Snapshot.RegionalOpportunityText}" />
                            <TextBlock Grid.Row="2" Classes="label" Text="Current Shocks" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding Snapshot.Prosperity.ActiveShocksText}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl
                Grid.Row="2"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Institutions">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ContentControl Content="{Binding Snapshot.ChurchCard}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="contracts:TownInstitutionAffairsInfo">
                                        <Border Margin="4" Padding="7" Background="#25FFF4D9" BorderBrush="#7E623D" BorderThickness="1" CornerRadius="4" Cursor="Hand" PointerPressed="OnInstitutionPointerPressed">
                                            <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                                                <Border Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#54000000" BorderBrush="#8A6435" BorderThickness="1.5" CornerRadius="4">
                                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="25" Text="{Binding Emoji}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock HorizontalAlignment="Left" TextAlignment="Left" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding DisplayName}" />
                                                    <TextBlock HorizontalAlignment="Left" TextAlignment="Left" FontSize="10.5" Foreground="#654621" TextWrapping="Wrap" Text="{Binding Summary}" />
                                                    <TextBlock IsVisible="{Binding HasServiceText}" Classes="value" FontSize="10.5" TextAlignment="Left" TextWrapping="Wrap" Text="{Binding ServiceText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Classes="value" FontSize="10.5" Text="{Binding CareerText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <ItemsControl ItemsSource="{Binding Snapshot.InstitutionCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <primitives:UniformGrid Columns="4" Rows="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="contracts:TownInstitutionAffairsInfo">
                                        <Border Margin="4" Padding="7" Background="#25FFF4D9" BorderBrush="#7E623D" BorderThickness="1" CornerRadius="4" Cursor="Hand" PointerPressed="OnInstitutionPointerPressed">
                                            <StackPanel Spacing="5">
                                                <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                                                    <Border Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#54000000" BorderBrush="#8A6435" BorderThickness="1.5" CornerRadius="4">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="25" Text="{Binding Emoji}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock HorizontalAlignment="Left" TextAlignment="Left" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding DisplayName}" />
                                                        <TextBlock HorizontalAlignment="Left" TextAlignment="Left" FontSize="10.5" Foreground="#654621" TextWrapping="Wrap" Text="{Binding Summary}" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock IsVisible="{Binding HasServiceText}" Classes="value" FontSize="10.5" TextAlignment="Left" TextWrapping="Wrap" Text="{Binding ServiceText}" />
                                                <TextBlock Classes="value" FontSize="10.5" TextAlignment="Left" TextWrapping="Wrap" Text="{Binding CareerText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Housing">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6" Spacing="8">
                            <TextBlock Classes="sectionHeader" Text="For Sale" />
                            <TextBlock IsVisible="{Binding ShowNoHouseOffers}" Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center" FontStyle="Italic" TextWrapping="Wrap" Text="{Binding NoHouseOffersText}" />
                            <ItemsControl ItemsSource="{Binding HouseOffers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TownAffairsHouseOfferViewModel">
                                        <Border Margin="2" Padding="10,7" Background="#25FFF4D9" BorderBrush="#A17A43" BorderThickness="1" CornerRadius="4">
                                            <Grid ColumnDefinitions="44,*,Auto,Auto" ColumnSpacing="10">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25" Text="🏠" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Text="{Binding CapacityText}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#5A3A18" Text="{Binding AskingPriceText}" />
                                                <Button Grid.Column="3" Classes="paperAction" VerticalAlignment="Center" Content="Buy" IsEnabled="{Binding IsAffordable}" Click="OnBuyHouseOfferClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Jobs" IsVisible="{Binding ShowJobsTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6" Spacing="6">
                            <ItemsControl IsVisible="{Binding ShowJobHouseholdMemberTabs}" ItemsSource="{Binding JobHouseholdMembers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TownAffairsMemberTabViewModel">
                                        <Button Classes="memberTab" Content="{Binding DisplayName}" IsEnabled="{Binding CanSelect}" Click="OnMemberTabClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock IsVisible="{Binding ShowJobsEmpty}" Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding JobsEmptyText}" />
                            <ItemsControl ItemsSource="{Binding JobModel.Opportunities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:JobOpportunityCardViewModel">
                                        <Border Margin="2" Padding="10,6" Background="#25FFF4D9" BorderBrush="#A17A43" BorderThickness="1" CornerRadius="4">
                                            <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="10">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Text="{Binding CareerEmoji}" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Text="{Binding Heading}" />
                                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="{Binding RequirementsText}" />
                                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="{Binding ApplicantComparisonText}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock FontSize="12.5" FontWeight="Bold" Foreground="#5A3A18" Text="{Binding SalaryText}" />
                                                        <TextBlock FontSize="11.5" FontWeight="Bold" Text="{Binding ChanceText}" Foreground="{Binding ChanceBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="paperAction" VerticalAlignment="Center" HorizontalAlignment="Right" Content="Apply" Click="OnApplyJobClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Health" IsVisible="{Binding ShowHealthTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6" Spacing="8">
                            <ItemsControl IsVisible="{Binding ShowHouseholdMemberTabs}" ItemsSource="{Binding HouseholdMembers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TownAffairsMemberTabViewModel">
                                        <Button Classes="memberTab" Content="{Binding DisplayName}" IsEnabled="{Binding CanSelect}" Click="OnMemberTabClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock IsVisible="{Binding ShowHealthEmpty}" Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center" FontStyle="Italic" TextWrapping="Wrap" Text="{Binding HealthEmptyText}" />
                            <ItemsControl ItemsSource="{Binding HealthActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TownAffairsHealthActionViewModel">
                                        <Border Margin="2" Padding="10,7" Background="#25FFF4D9" BorderBrush="#A17A43" BorderThickness="1" CornerRadius="4" Opacity="{Binding DisplayOpacity}" ToolTip.Tip="{Binding UnavailableReason}">
                                            <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="10">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Text="{Binding Emoji}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding Label}" />
                                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="{Binding Description}" />
                                                    <TextBlock IsVisible="{Binding HasCost}" FontSize="11.5" FontWeight="Bold" Text="{Binding CostText}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="paperAction" VerticalAlignment="Center" IsEnabled="{Binding IsAvailable}" Content="Queue" Click="OnHealthActionClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Education" IsVisible="{Binding ShowEducationTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6" Spacing="6">
                            <ItemsControl IsVisible="{Binding ShowHouseholdMemberTabs}" ItemsSource="{Binding HouseholdMembers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TownAffairsMemberTabViewModel">
                                        <Button Classes="memberTab" Content="{Binding DisplayName}" IsEnabled="{Binding CanSelect}" Click="OnMemberTabClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock FontStyle="Italic" TextWrapping="Wrap" Text="{Binding EducationContextText}" />
                            <TextBlock IsVisible="{Binding ShowEducationEmpty}" TextWrapping="Wrap" Text="{Binding EducationEmptyText}" />
                            <ItemsControl ItemsSource="{Binding EducationOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PropertySelectionOption">
                                        <Border Margin="2" Padding="10,7" Background="#25FFF4D9" BorderBrush="#A17A43" BorderThickness="1" CornerRadius="4" Opacity="{Binding DisplayOpacity}">
                                            <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="10">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Text="{Binding LeadingEmoji}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding PrimaryText}" />
                                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="{Binding SecondaryText}" />
                                                    <TextBlock IsVisible="{Binding HasDetailsText}" FontSize="11.5" TextWrapping="Wrap" Text="{Binding DetailsText}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock FontSize="11.5" FontWeight="Bold" Text="{Binding PriceText}" />
                                                        <TextBlock IsVisible="{Binding HasSuccessChance}" FontSize="11.5" FontWeight="Bold" Foreground="{Binding SuccessChanceBrush}" Text="{Binding SuccessChanceText}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="paperAction" VerticalAlignment="Center" Content="Study" IsEnabled="{Binding IsEnabled}" Click="OnEducationClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Bank" IsVisible="{Binding ShowBankTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6" Spacing="10">
                            <TextBlock Classes="sectionHeader" Text="{Binding Snapshot.Bank.DisplayName}" />
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" Text="{Binding BankStatusText}" />

                            <Border Padding="12,9" Background="#25FFF4D9" BorderBrush="#A17A43" BorderThickness="1" CornerRadius="4">
                                <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="12">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Text="🏦" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="14" FontWeight="Bold" Text="Take a Loan" />
                                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="Review the bank's current borrowing offers for this household." />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="paperAction" VerticalAlignment="Center" IsEnabled="{Binding CanTakeLoan}" Content="View Offers" Click="OnTakeLoanClick" />
                                </Grid>
                            </Border>

                            <Border Padding="12,9" Background="#25FFF4D9" BorderBrush="#A17A43" BorderThickness="1" CornerRadius="4">
                                <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="12">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Text="🤝" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontSize="14" FontWeight="Bold" Text="Give a Loan" />
                                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="Review lending opportunities arranged through the local bank." />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="paperAction" VerticalAlignment="Center" IsEnabled="{Binding CanGiveLoan}" Content="View Offers" Click="OnGiveLoanClick" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Church" IsVisible="{Binding ShowChurchTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6" Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock VerticalAlignment="Center" FontSize="30" Text="⛪" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Classes="sectionHeader" Text="{Binding Snapshot.Church.DisplayName}" />
                                    <TextBlock FontSize="12" Foreground="#654621" Text="{Binding Snapshot.Church.Summary}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="Church actions are queued for the next year. Attendance has only a small Morals effect; direct charity favors Reputation while Church donations favor Renown." />
                            <TextBlock IsVisible="{Binding ShowChurchEmpty}" Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center" FontStyle="Italic" Text="No Church action is currently available." />
                            <ItemsControl ItemsSource="{Binding ChurchActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TownAffairsChurchActionViewModel">
                                        <Border Margin="2" Padding="10,7" Background="#25FFF4D9" BorderBrush="#A17A43" BorderThickness="1" CornerRadius="4" Opacity="{Binding DisplayOpacity}" ToolTip.Tip="{Binding UnavailableReason}">
                                            <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="10">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Text="{Binding Emoji}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Label}" />
                                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="{Binding Description}" />
                                                    <TextBlock IsVisible="{Binding HasAmount}" FontSize="11.5" FontWeight="Bold" Text="{Binding AmountText}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="paperAction" VerticalAlignment="Center" IsEnabled="{Binding IsAvailable}" Content="Queue" Click="OnChurchActionClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Court" IsVisible="{Binding ShowCourtTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6" Spacing="8">
                            <ItemsControl IsVisible="{Binding ShowJobHouseholdMemberTabs}" ItemsSource="{Binding JobHouseholdMembers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TownAffairsMemberTabViewModel">
                                        <Button Classes="memberTab" Content="{Binding DisplayName}" IsEnabled="{Binding CanSelect}" Click="OnMemberTabClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock VerticalAlignment="Center" FontSize="30" Text="⚖️" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Classes="sectionHeader" Text="Court / Justice" />
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding CourtModel.CourtText}" />
                                    <TextBlock IsVisible="{Binding CourtModel.ShowNoLocalCourt}" FontSize="11.5" FontStyle="Italic" TextWrapping="Wrap" Text="Court actions still function through outside authorities." />
                                </StackPanel>
                            </Grid>

                            <Border Padding="10,8" Background="#20FFF4D9" BorderBrush="#A17A43" BorderThickness="1" CornerRadius="4">
                                <StackPanel Spacing="3">
                                    <TextBlock FontWeight="Bold" Text="{Binding CourtModel.ProtectionText}" />
                                    <TextBlock IsVisible="{Binding CourtModel.HasProtectionHelper}" FontSize="11.5" TextWrapping="Wrap" Text="{Binding CourtModel.ProtectionHelperText}" />
                                    <TextBlock FontSize="11.5" Text="{Binding CourtModel.ImprisonmentText}" />
                                    <TextBlock IsVisible="{Binding CourtModel.HasBailCost}" FontSize="11.5" FontWeight="Bold" Text="{Binding CourtModel.BailCostText}" />
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="{Binding CourtModel.StolenSaleRiskText}" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding CourtModel.Actions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TownAffairsCourtActionViewModel">
                                        <Border Margin="2" Padding="10,7" Background="#25FFF4D9" BorderBrush="#A17A43" BorderThickness="1" CornerRadius="4" Opacity="{Binding DisplayOpacity}" ToolTip.Tip="{Binding UnavailableReason}">
                                            <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="10">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Text="{Binding Emoji}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding Label}" />
                                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="{Binding Description}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="paperAction" VerticalAlignment="Center" IsEnabled="{Binding IsAvailable}" Content="Queue" Click="OnCourtActionClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="Bold" Text="Known Criminal Record" />
                            <TextBlock IsVisible="{Binding CourtModel.ShowNoCriminalRecord}" FontSize="11.5" FontStyle="Italic" Text="No known criminal offenses." />
                            <ItemsControl ItemsSource="{Binding CourtModel.CriminalRecord}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="contracts:CriminalRecordEntryInfo">
                                        <Border Margin="2" Padding="9,6" Background="#18FFF4D9" BorderBrush="#B18C59" BorderThickness="1" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock FontSize="12.5" FontWeight="Bold" Text="{Binding CrimeName}" />
                                                <TextBlock FontSize="11.5" Text="{Binding Year, StringFormat='Year {0}'}" />
                                                <TextBlock FontSize="11.5" Text="{Binding OriginalSentence, StringFormat='Sentence: {0} years originally'}" />
                                                <TextBlock FontSize="11.5" Text="{Binding FinalSentence, StringFormat='Final sentence: {0} years'}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Community" IsVisible="{Binding ShowCommunityTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6" Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock VerticalAlignment="Center" FontSize="30" Text="🏛️" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Classes="sectionHeader" Text="Community" />
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="Each year the town considers three deterministic local proposals. You may spend the household's annual action lobbying one proposal; passage is never guaranteed." />
                                </StackPanel>
                            </Grid>

                            <Border IsVisible="{Binding HasCivicOffice}" Padding="10,8" Background="#20FFF4D9" BorderBrush="#A17A43" BorderThickness="1" CornerRadius="4">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="5">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="13" FontWeight="Bold" Text="{Binding CivicOffice.OfficeTitle}" />
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding CivicOfficePersonText}" />
                                        <TextBlock FontSize="11" Foreground="#654621" Text="{Binding CivicOfficeStandingText}" />
                                        <TextBlock FontSize="11" Foreground="#654621" Text="{Binding CivicOfficeTermText}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" IsVisible="{Binding HasOfficeDutiesAction}" Classes="paperAction" VerticalAlignment="Center" IsEnabled="{Binding CanPerformOfficeDuties}" Content="Perform Duties" ToolTip.Tip="{Binding OfficeDutiesUnavailableReason}" Click="OnOfficeDutiesClick" />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,3,0,0" FontSize="13" FontWeight="Bold" Text="Active policies" />
                            <TextBlock IsVisible="{Binding ShowNoActiveCommunityPolicies}" FontSize="11.5" FontStyle="Italic" Text="No temporary community policy is currently active." />
                            <ItemsControl ItemsSource="{Binding ActiveCommunityPolicies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TownAffairsActivePolicyViewModel">
                                        <Border Margin="2" Padding="9,6" Background="#18FFF4D9" BorderBrush="#B18C59" BorderThickness="1" CornerRadius="4">
                                            <StackPanel Spacing="2">
                                                <TextBlock FontSize="13" FontWeight="Bold" Text="{Binding Policy.DisplayName}" />
                                                <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="{Binding Policy.Description}" />
                                                <TextBlock FontSize="11" Foreground="#654621" Text="{Binding DurationText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="Bold" Text="This year's proposals" />
                            <TextBlock IsVisible="{Binding ShowCommunityEmpty}" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" FontStyle="Italic" Text="No eligible community proposals are available this year." />
                            <ItemsControl ItemsSource="{Binding CommunityProposals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TownAffairsCommunityProposalViewModel">
                                        <Border Margin="2" Padding="10,8" Background="#25FFF4D9" BorderBrush="#A17A43" BorderThickness="1" CornerRadius="4" Opacity="{Binding DisplayOpacity}" ToolTip.Tip="{Binding UnavailableReason}">
                                            <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="10">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="28" Text="{Binding Emoji}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Proposal.DisplayName}" />
                                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="{Binding Proposal.Description}" />
                                                    <TextBlock FontSize="11" Foreground="#654621" TextWrapping="Wrap" Text="{Binding ProposerText}" />
                                                    <TextBlock FontSize="11" Foreground="#654621" TextWrapping="Wrap" Text="{Binding DetailText}" />
                                                    <TextBlock IsVisible="{Binding HasLobbyBonus}" FontSize="11.5" FontWeight="Bold" Text="{Binding LobbyBonusText}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="paperAction" VerticalAlignment="Center" IsEnabled="{Binding IsAvailable}" Content="Lobby" Click="OnCommunityLobbyClick" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <controls:ImageStateButton
                Grid.Row="3"
                Width="170"
                Height="60"
                HorizontalAlignment="Center"
                IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                FallbackText="Close"
                Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
