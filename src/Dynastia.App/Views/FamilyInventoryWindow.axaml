<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Dynastia.App.Controls"
    xmlns:vm="using:Dynastia.App.ViewModels"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    x:Class="Dynastia.App.Views.FamilyInventoryWindow"
    x:DataType="vm:FamilyInventoryWindowViewModel"
    Width="1040"
    Height="800"
    MinWidth="1040"
    MinHeight="800"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    Title="Family Inventory">

    <Window.Styles>
        <Style Selector="Button.inventoryAction">
            <Setter Property="MinWidth" Value="136" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#E6D2AA" />
            <Setter Property="Foreground" Value="#3A2413" />
            <Setter Property="BorderBrush" Value="#93662F" />
            <Setter Property="BorderThickness" Value="1.3" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.inventoryAction:pointerover">
            <Setter Property="Background" Value="#D4AF73" />
        </Style>
        <Style Selector="Button.inventoryAction:disabled">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
        <Style Selector="ComboBox.houseHeir">
            <Setter Property="Width" Value="180" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#352110" />
            <Setter Property="Background" Value="#F2E2BD" />
            <Setter Property="BorderBrush" Value="#93662F" />
        </Style>
        <Style Selector="TextBlock.inventoryEmpty">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="#6B5131" />
        </Style>
        <Style Selector="Border.inventoryAssetCard">
            <Setter Property="MinHeight" Value="238" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="11" />
            <Setter Property="Background" Value="#44F8EDD1" />
            <Setter Property="BorderBrush" Value="#A17A43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.inventoryAssetIcon">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="#55F4E4BC" />
            <Setter Property="BorderBrush" Value="#9C7440" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="TextBlock.inventoryAssetTitle">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#46321C" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.inventoryAssetDetail">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#6B5131" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.inventoryAssetValue">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#46321C" />
        </Style>
        <Style Selector="TextBlock.inventoryInheritanceLabel">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#46321C" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#352110" />
            <Setter Property="Padding" Value="22,8" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image
            Source="/Assets/UI/instructions_paper.png"
            Stretch="Fill" />

        <Grid
            Margin="76,64,76,50"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="10">

            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                FontSize="42"
                Foreground="#2F1D0E"
                Text="Family Inventory" />

            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontFamily="Georgia"
                FontSize="19"
                FontWeight="Bold"
                Foreground="#4B321B"
                Text="{Binding HouseholdName}" />

            <TabControl
                Grid.Row="2"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                Background="#0FFFFFFF"
                BorderBrush="#8F6A34"
                BorderThickness="1.5">

                <TabItem Header="Money">
                    <ScrollViewer
                        Margin="8"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Border
                                Margin="4"
                                Padding="16,13"
                                Background="#35FFF4D9"
                                BorderBrush="#A17A43"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid ColumnDefinitions="5*,6*" ColumnSpacing="20">
                                    <StackPanel Spacing="7">
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#352110"
                                            Text="{Binding BudgetText}" />

                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="#5A3A18"
                                            Text="{Binding IncomeTotalText}" />
                                        <ItemsControl ItemsSource="{Binding Incomes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InventoryFinanceLineViewModel">
                                                    <Grid Margin="0,1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="12"
                                                            Foreground="#46321C"
                                                            TextWrapping="Wrap"
                                                            Text="{Binding Label}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontFamily="Georgia"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            Text="{Binding AmountText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontFamily="Georgia"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="#5A3A18"
                                            Text="{Binding ExpenseTotalText}" />
                                        <ItemsControl ItemsSource="{Binding Expenses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InventoryFinanceLineViewModel">
                                                    <Grid Margin="0,1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="12"
                                                            Foreground="#46321C"
                                                            TextWrapping="Wrap"
                                                            Text="{Binding Label}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontFamily="Georgia"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            Text="{Binding AmountText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <ui:HouseholdBudgetGraph
                                            Height="142"
                                            History="{Binding BudgetHistory}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontFamily="Georgia"
                                            FontSize="10"
                                            Foreground="#6B5131"
                                            Text="{Binding BudgetHistoryRangeText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="4" ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Border
                                    Padding="14,12"
                                    Background="#35FFF4D9"
                                    BorderBrush="#A17A43"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel Spacing="9">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Georgia"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Foreground="#352110"
                                                Text="💰 Loans" />
                                            <Button
                                                Grid.Column="1"
                                                Classes="inventoryAction"
                                                MinWidth="120"
                                                IsEnabled="{Binding CanVisitBank}"
                                                Content="Visit a Bank"
                                                Click="OnVisitBankClick" />
                                        </Grid>

                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="12"
                                            FontStyle="Italic"
                                            Foreground="#6B5131"
                                            Text="{Binding LoanEmptyText}" />

                                        <ItemsControl ItemsSource="{Binding Loans}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InventoryLoanLineViewModel">
                                                    <StackPanel Margin="0,3" Spacing="1">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="12.5"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            Text="{Binding Title}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="11"
                                                            Foreground="#46321C"
                                                            TextWrapping="Wrap"
                                                            Text="{Binding DetailsText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="14,12"
                                    Background="#35FFF4D9"
                                    BorderBrush="#A17A43"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel Spacing="9">
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#352110"
                                            Text="🎩 Lifestyle Spending" />

                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="#5A3A18"
                                            Text="{Binding LifestyleText, StringFormat='Current: {0}'}" />

                                        <TextBlock
                                            MinHeight="48"
                                            FontFamily="Georgia"
                                            FontSize="11"
                                            Foreground="#6B5131"
                                            TextWrapping="Wrap"
                                            Text="{Binding LifestyleDescription}" />

                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Classes="inventoryAction"
                                                Width="104"
                                                MinWidth="0"
                                                IsEnabled="{Binding CanUseLavishLifestyle}"
                                                Tag="economy.lifestyle.lavish"
                                                Content="💎 Lavish"
                                                Click="OnLifestyleClick">
                                                <ToolTip.Tip>
                                                    <TextBlock
                                                        MaxWidth="290"
                                                        TextWrapping="Wrap"
                                                        Text="+10% living costs. Slightly improves child happiness, marriage and job satisfaction, health recovery, education and spouse prospects, while reducing Stress." />
                                                </ToolTip.Tip>
                                            </Button>
                                            <Button
                                                Classes="inventoryAction"
                                                Width="104"
                                                MinWidth="0"
                                                IsEnabled="{Binding CanUseBalancedLifestyle}"
                                                Tag="economy.lifestyle.balanced"
                                                Content="⚖️ Balanced"
                                                Click="OnLifestyleClick">
                                                <ToolTip.Tip>
                                                    <TextBlock
                                                        MaxWidth="290"
                                                        TextWrapping="Wrap"
                                                        Text="Standard living costs with no Lifestyle bonuses or penalties." />
                                                </ToolTip.Tip>
                                            </Button>
                                            <Button
                                                Classes="inventoryAction"
                                                Width="104"
                                                MinWidth="0"
                                                IsEnabled="{Binding CanUseThriftyLifestyle}"
                                                Tag="economy.lifestyle.thrifty"
                                                Content="🪙 Thrifty"
                                                Click="OnLifestyleClick">
                                                <ToolTip.Tip>
                                                    <TextBlock
                                                        MaxWidth="290"
                                                        TextWrapping="Wrap"
                                                        Text="-10% living costs. Slightly lowers child happiness, marriage and job satisfaction, health recovery, education and spouse prospects, while increasing Stress." />
                                                </ToolTip.Tip>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Houses">
                    <ScrollViewer
                        Margin="8"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <StackPanel Height="34" Margin="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Classes="inventoryAction"
                                        IsEnabled="{Binding CanBuyHouse}"
                                        Content="Buy a House"
                                        Click="OnBuyHouseClick" />
                                    <Button
                                        Classes="inventoryAction"
                                        IsEnabled="{Binding CanSellHouse}"
                                        Content="Sell a House"
                                        Click="OnSellHouseClick" />
                            </StackPanel>

                            <TextBlock
                                Classes="inventoryEmpty"
                                IsVisible="{Binding ShowHouseEmpty}"
                                Text="{Binding HouseEmptyText}" />

                            <ItemsControl ItemsSource="{Binding Houses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <primitives:UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InventoryHouseViewModel">
                                        <Border Classes="inventoryAssetCard">
                                            <Grid RowDefinitions="108,Auto,Auto" RowSpacing="9">
                                                <Grid ColumnDefinitions="54,*" ColumnSpacing="10">
                                                    <Border Classes="inventoryAssetIcon">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="28"
                                                            Text="{Binding Emoji}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Classes="inventoryAssetTitle" Text="{Binding TownText}" />
                                                        <TextBlock Classes="inventoryAssetDetail" Text="{Binding CapacityText}" />
                                                        <TextBlock Classes="inventoryAssetValue" Text="{Binding ValueText}" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                                    <Button
                                                        Classes="inventoryAction"
                                                        MinWidth="0"
                                                        IsEnabled="{Binding CanExtend}"
                                                        Tag="{Binding PropertyId}"
                                                        Content="{Binding ExtendActionText}"
                                                        Click="OnExtendHouseClick" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Spacing="4">
                                                    <TextBlock Classes="inventoryInheritanceLabel" Text="Inheritance:" />
                                                    <ComboBox
                                                        Classes="houseHeir"
                                                        HorizontalAlignment="Left"
                                                        ItemsSource="{Binding HeirOptions}"
                                                        SelectedItem="{Binding SelectedHeir, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:HouseHeirOptionViewModel">
                                                                <TextBlock
                                                                    FontFamily="Georgia"
                                                                    FontSize="12"
                                                                    Foreground="#352110"
                                                                    Text="{Binding Label}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Farmland">
                    <ScrollViewer
                        Margin="8"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <StackPanel Height="34" Margin="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Classes="inventoryAction"
                                        IsEnabled="{Binding CanBuyFarmland}"
                                        Content="{Binding BuyFarmlandActionText}"
                                        Click="OnBuyFarmlandClick" />
                                    <Button
                                        Classes="inventoryAction"
                                        IsEnabled="{Binding CanSellFarmland}"
                                        Content="{Binding SellFarmlandActionText}"
                                        Click="OnSellFarmlandClick" />
                            </StackPanel>

                            <TextBlock
                                Classes="inventoryEmpty"
                                IsVisible="{Binding ShowFarmlandEmpty}"
                                Text="{Binding FarmlandEmptyText}" />

                            <ItemsControl ItemsSource="{Binding Farmland}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <primitives:UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InventoryFarmlandViewModel">
                                        <Border Classes="inventoryAssetCard">
                                            <Grid RowDefinitions="108,Auto,Auto" RowSpacing="9">
                                                <Grid ColumnDefinitions="54,*" ColumnSpacing="10">
                                                    <Border Classes="inventoryAssetIcon">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="28"
                                                            Text="{Binding Emoji}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Classes="inventoryAssetTitle" Text="{Binding FarmTypeText}" />
                                                        <TextBlock Classes="inventoryAssetDetail" Text="{Binding LivestockText}" />
                                                        <TextBlock Classes="inventoryAssetValue" Text="{Binding ValueText}" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                                    <Button
                                                        Classes="inventoryAction"
                                                        MinWidth="0"
                                                        IsEnabled="{Binding CanAddLivestock}"
                                                        Tag="{Binding FarmlandId}"
                                                        Content="{Binding AddLivestockActionText}"
                                                        Click="OnAddLivestockClick" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Spacing="4">
                                                    <TextBlock Classes="inventoryInheritanceLabel" Text="Inheritance:" />
                                                    <ComboBox
                                                        Classes="houseHeir"
                                                        HorizontalAlignment="Left"
                                                        ItemsSource="{Binding HeirOptions}"
                                                        SelectedItem="{Binding SelectedHeir, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:HouseHeirOptionViewModel">
                                                                <TextBlock
                                                                    FontFamily="Georgia"
                                                                    FontSize="12"
                                                                    Foreground="#352110"
                                                                    Text="{Binding Label}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Heirlooms">
                    <ScrollViewer
                        Margin="8"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Grid Height="34" Margin="4" />

                            <TextBlock
                                Classes="inventoryEmpty"
                                IsVisible="{Binding ShowHeirloomEmpty}"
                                Text="{Binding HeirloomEmptyText}" />

                            <ItemsControl ItemsSource="{Binding Heirlooms}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <primitives:UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InventoryHeirloomViewModel">
                                        <Border Classes="inventoryAssetCard">
                                            <Grid RowDefinitions="108,Auto,Auto" RowSpacing="9">
                                                <Grid ColumnDefinitions="54,*" ColumnSpacing="10">
                                                    <Border Classes="inventoryAssetIcon">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="28"
                                                            Text="{Binding Emoji}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Classes="inventoryAssetTitle" Text="{Binding DisplayName}" />
                                                        <TextBlock Classes="inventoryAssetDetail" MaxHeight="44" Text="{Binding OriginText}" />
                                                        <TextBlock Classes="inventoryAssetDetail" Text="{Binding AcquiredText}" />
                                                        <TextBlock Classes="inventoryAssetValue" Text="{Binding ValueText}" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                                    <Button
                                                        Classes="inventoryAction"
                                                        MinWidth="0"
                                                        IsEnabled="{Binding CanSell}"
                                                        Tag="{Binding HeirloomId}"
                                                        Content="Sell"
                                                        Click="OnSellHeirloomClick" />
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Spacing="4">
                                                    <TextBlock Classes="inventoryInheritanceLabel" Text="Inheritance:" />
                                                    <ComboBox
                                                        Classes="houseHeir"
                                                        HorizontalAlignment="Left"
                                                        ItemsSource="{Binding HeirOptions}"
                                                        SelectedItem="{Binding SelectedHeir, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:HouseHeirOptionViewModel">
                                                                <TextBlock
                                                                    FontFamily="Georgia"
                                                                    FontSize="12"
                                                                    Foreground="#352110"
                                                                    Text="{Binding Label}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <ui:ImageStateButton
                Grid.Row="3"
                Width="170"
                Height="70"
                HorizontalAlignment="Center"
                IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                FallbackText="Close"
                Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
