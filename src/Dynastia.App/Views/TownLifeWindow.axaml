<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:Dynastia.Contracts"
    xmlns:controls="using:Dynastia.App.Controls"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    x:Class="Dynastia.App.Views.TownLifeWindow"
    x:DataType="contracts:TownLifeSnapshot"
    Width="960"
    Height="760"
    MinWidth="960"
    MinHeight="760"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    Title="Town / City Affairs"
    KeyDown="OnKeyDown">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="Foreground" Value="#352110" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#5A3A18" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#654621" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.section">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="#35FFF4D9" />
            <Setter Property="BorderBrush" Value="#A17A43" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.closeButton">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="#E6D2AA" />
            <Setter Property="Foreground" Value="#3A2413" />
            <Setter Property="BorderBrush" Value="#93662F" />
            <Setter Property="BorderThickness" Value="1.3" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image Source="/Assets/UI/instructions_paper.png" Stretch="Fill" />

        <Grid Margin="70,54,70,42" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="9">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                FontSize="38"
                Foreground="#2F1D0E"
                Text="{Binding NavigationLabel}" />

            <Grid Grid.Row="1" ColumnDefinitions="5*,6*" ColumnSpacing="10">
                <Border Classes="section">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="#5A3A18"
                            Text="{Binding Town.Town}" />
                        <Grid ColumnDefinitions="104,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                            <TextBlock Classes="label" FontSize="13" Text="Polity" />
                            <TextBlock Grid.Column="1" Classes="value" FontSize="13" Text="{Binding Town.PolityName}" />
                            <TextBlock Grid.Row="1" Classes="label" FontSize="13" Text="Region" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" FontSize="13" Text="{Binding RegionName}" />
                            <TextBlock Grid.Row="2" Classes="label" FontSize="13" Text="Settlement" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" FontSize="13" Text="{Binding Town.SettlementClassDisplayName}" />
                            <TextBlock Grid.Row="3" Classes="label" FontSize="13" Text="Population" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" FontSize="13" Text="{Binding PopulationText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="section">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="sectionHeader" Text="Local Economy" />
                            <TextBlock FontSize="19" FontWeight="Bold" Foreground="#7A561E" Text="{Binding Prosperity.Index}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" Text="{Binding Prosperity.Label}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Prosperity.TrendText}" />
                        </StackPanel>

                        <controls:TownProsperityGraph
                            Height="82"
                            History="{Binding Prosperity.HistoryPoints}" />

                        <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">
                            <TextBlock Classes="label" Text="Trend years" />
                            <TextBlock Grid.Column="1" Classes="value" Text="{Binding Prosperity.HistoryRangeText}" />
                            <TextBlock Grid.Row="1" Classes="label" Text="Strong fields" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding LocalOpportunityText}" />
                            <TextBlock Grid.Row="2" Classes="label" Text="Regional support" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding RegionalOpportunityText}" />
                            <TextBlock Grid.Row="3" Classes="label" Text="Shocks" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding Prosperity.ActiveShocksText}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Classes="section">
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <TextBlock Classes="sectionHeader" Text="Institutions" />

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding InstitutionCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <primitives:UniformGrid Columns="4" Rows="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="contracts:TownInstitutionAffairsInfo">
                                <Border
                                    Margin="4"
                                    Padding="7"
                                    Background="#25FFF4D9"
                                    BorderBrush="#7E623D"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                                            <Border
                                                Width="38"
                                                Height="38"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="#54000000"
                                                BorderBrush="#8A6435"
                                                BorderThickness="1.5"
                                                CornerRadius="4">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    TextAlignment="Center"
                                                    FontSize="22"
                                                    Text="{Binding Emoji}" />
                                            </Border>

                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="1">
                                                <TextBlock
                                                    HorizontalAlignment="Left"
                                                    TextAlignment="Left"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    HorizontalAlignment="Left"
                                                    TextAlignment="Left"
                                                    FontSize="10.5"
                                                    Foreground="#654621"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding Summary}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock
                                            IsVisible="{Binding HasServiceText}"
                                            Classes="value"
                                            FontSize="10.5"
                                            TextAlignment="Left"
                                            TextWrapping="Wrap"
                                            Text="{Binding ServiceText}" />
                                        <TextBlock
                                            Classes="value"
                                            FontSize="10.5"
                                            TextAlignment="Left"
                                            TextWrapping="Wrap"
                                            Text="{Binding CareerText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Button
                Grid.Row="3"
                HorizontalAlignment="Center"
                Classes="closeButton"
                Click="OnCloseClick"
                Content="Close" />
        </Grid>
    </Grid>
</Window>
