<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Dynastia.App.Views.LoanSelectionWindow"
    Width="760"
    Height="610"
    CanResize="False"
    ShowInTaskbar="False"
    SystemDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    KeyDown="OnWindowKeyDown"
    Title="Take a Loan">

    <Window.Styles>
        <Style Selector="Button.paperAction">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Foreground" Value="#3F2714" />
            <Setter Property="Background" Value="#E8D5AF" />
            <Setter Property="BorderBrush" Value="#9D6F35" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Button.paperAction:pointerover">
            <Setter Property="Background" Value="#D4B178" />
            <Setter Property="Foreground" Value="#2D1A0E" />
        </Style>

        <Style Selector="Slider.paperSlider">
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image
            Source="/Assets/UI/instructions_paper.png"
            Stretch="Fill" />

        <Grid
            Margin="78,70,78,56"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="17">

            <TextBlock
                x:Name="TitleText"
                HorizontalAlignment="Center"
                FontFamily="avares://Dynastia.App/Assets/Fonts#UnifrakturCook"
                FontSize="42"
                Foreground="#2F1D0E"
                Text="Take a Loan" />

            <Grid
                Grid.Row="1"
                ColumnDefinitions="*,*"
                ColumnSpacing="26">

                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            FontFamily="Georgia"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#4B321B"
                            Text="Amount" />
                        <TextBlock
                            x:Name="AmountSelectionText"
                            Grid.Column="1"
                            FontFamily="Georgia"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#6A451A"
                            Text="1,000 zł" />
                    </Grid>

                    <Slider
                        x:Name="AmountSlider"
                        Classes="paperSlider"
                        Minimum="1"
                        Maximum="10"
                        Value="1"
                        SmallChange="1"
                        LargeChange="1"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="OnSliderValueChanged" />

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock
                            FontFamily="Georgia"
                            FontSize="11"
                            Foreground="#745A38"
                            Text="1,000 zł" />
                        <TextBlock
                            Grid.Column="2"
                            FontFamily="Georgia"
                            FontSize="11"
                            Foreground="#745A38"
                            Text="10,000 zł" />
                    </Grid>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            FontFamily="Georgia"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#4B321B"
                            Text="Duration" />
                        <TextBlock
                            x:Name="DurationSelectionText"
                            Grid.Column="1"
                            FontFamily="Georgia"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="#6A451A"
                            Text="1 year" />
                    </Grid>

                    <Slider
                        x:Name="DurationSlider"
                        Classes="paperSlider"
                        Minimum="1"
                        Maximum="50"
                        Value="1"
                        SmallChange="1"
                        LargeChange="5"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ValueChanged="OnSliderValueChanged" />

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock
                            FontFamily="Georgia"
                            FontSize="11"
                            Foreground="#745A38"
                            Text="1 year" />
                        <TextBlock
                            Grid.Column="2"
                            FontFamily="Georgia"
                            FontSize="11"
                            Foreground="#745A38"
                            Text="50 years" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="2"
                Padding="18"
                Background="#22FFF8E8"
                BorderBrush="#9D7544"
                BorderThickness="1.5"
                CornerRadius="6">
                <StackPanel Spacing="10">
                    <TextBlock
                        x:Name="AmountText"
                        FontFamily="Georgia"
                        FontSize="16"
                        Foreground="#392615" />
                    <TextBlock
                        x:Name="DurationText"
                        FontFamily="Georgia"
                        FontSize="15"
                        Foreground="#392615" />
                    <TextBlock
                        x:Name="InterestText"
                        FontFamily="Georgia"
                        FontSize="15"
                        Foreground="#392615" />
                    <TextBlock
                        x:Name="AnnualPaymentText"
                        FontFamily="Georgia"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#5E3B12" />
                    <TextBlock
                        x:Name="TotalRepaymentText"
                        FontFamily="Georgia"
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#5E3B12" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontFamily="Georgia"
                        FontSize="12"
                        FontStyle="Italic"
                        Foreground="#6B5434"
                        TextWrapping="Wrap"
                        Text="Interest is the total cost over the whole contract, not an annual percentage. Payments are rounded to full zł; the final payment absorbs any rounding remainder. The first repayment is due one Year Advance after the loan is issued." />
                </StackPanel>
            </Border>

            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="ConfirmButton"
                    Classes="paperAction"
                    Content="Take Loan"
                    Click="OnConfirmClick" />
                <Button
                    Classes="paperAction"
                    Content="Close"
                    Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
