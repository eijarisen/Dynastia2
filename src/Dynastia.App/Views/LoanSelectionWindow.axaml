<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Dynastia.App.Controls"
    xmlns:vm="using:Dynastia.App.ViewModels"
    x:Class="Dynastia.App.Views.LoanSelectionWindow"
    Width="860"
    Height="690"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    KeyDown="OnWindowKeyDown"
    Title="Loan Offers">

    <Window.Styles>
        <Style Selector="Button.paperAction">
            <Setter Property="MinWidth" Value="105" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="#3F2714" />
            <Setter Property="Background" Value="#E8D5AF" />
            <Setter Property="BorderBrush" Value="#9D6F35" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.paperAction:pointerover">
            <Setter Property="Background" Value="#D4B178" />
            <Setter Property="Foreground" Value="#2D1A0E" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image
            Source="/Assets/UI/instructions_paper.png"
            Stretch="Fill" />

        <Grid
            Margin="78,62,78,50"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="10">

            <TextBlock
                x:Name="TitleText"
                HorizontalAlignment="Center"
                FontFamily="avares://Dynastia.App/Assets/Fonts#UnifrakturCook"
                FontSize="42"
                Foreground="#2F1D0E"
                Text="Loan Offers" />

            <TextBlock
                x:Name="IntroText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                FontFamily="Georgia"
                FontSize="13"
                Foreground="#5B4024"
                Text="Choose one of the available offers." />

            <ItemsControl
                x:Name="OffersList"
                Grid.Row="2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LoanOfferCardViewModel">
                        <Border
                            Margin="5,4"
                            Padding="14,11"
                            Background="#35FFF4D9"
                            BorderBrush="#A17A43"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="14">
                                <Border
                                    Width="64"
                                    Height="64"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#54000000"
                                    BorderBrush="#8A6435"
                                    BorderThickness="1.5"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        FontSize="40"
                                        Text="{Binding PortraitEmoji}" />
                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        FontFamily="Georgia"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="#352110"
                                        Text="{Binding Heading}" />
                                    <TextBlock
                                        FontFamily="Georgia"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="#6A451A"
                                        Text="{Binding RoleText}" />
                                    <Grid
                                        Margin="0,3,0,0"
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="12">
                                        <StackPanel Spacing="1">
                                            <TextBlock
                                                FontFamily="Georgia"
                                                FontSize="12"
                                                Foreground="#46321C"
                                                Text="{Binding AmountText}" />
                                            <TextBlock
                                                FontFamily="Georgia"
                                                FontSize="12"
                                                Foreground="#46321C"
                                                Text="{Binding DurationText}" />
                                            <TextBlock
                                                FontFamily="Georgia"
                                                FontSize="12"
                                                Foreground="#46321C"
                                                Text="{Binding InterestText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock
                                                FontFamily="Georgia"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="#5E3B12"
                                                Text="{Binding AnnualPaymentText}" />
                                            <TextBlock
                                                FontFamily="Georgia"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="#5E3B12"
                                                Text="{Binding TotalText}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    Classes="paperAction"
                                    VerticalAlignment="Center"
                                    Content="{Binding ActionText}"
                                    Click="OnOfferClick" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:ImageStateButton
                Grid.Row="3"
                Width="170"
                Height="64"
                HorizontalAlignment="Center"
                IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                FallbackText="Close"
                Click="OnCancelClick" />
        </Grid>
    </Grid>
</Window>
