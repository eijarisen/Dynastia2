<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Dynastia.App.Views.InstructionsWindow"
    Width="900"
    Height="700"
    MinWidth="700"
    MinHeight="520"
    WindowStartupLocation="CenterOwner"
    Title="Dynastia — Instructions">

    <Grid Background="#071416">
        <Image
            Source="/Assets/UI/bg.png"
            Stretch="UniformToFill"
            Opacity="0.6" />

        <Border
            Margin="42"
            Padding="30"
            Background="#D9071112"
            BorderBrush="#B98A34"
            BorderThickness="2"
            CornerRadius="8">

            <Grid RowDefinitions="Auto,*,Auto"
                  RowSpacing="18">

                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="avares://Dynastia.App/Assets/Fonts#UnifrakturCook"
                    FontSize="42"
                    Foreground="#E0B64C"
                    Text="Instructions" />

                <ScrollViewer Grid.Row="1">
                    <StackPanel
                        Spacing="12">

                        <StackPanel.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="Foreground" Value="#F2E6C9" />
                                <Setter Property="FontFamily" Value="Georgia" />
                                <Setter Property="FontSize" Value="15" />
                            </Style>
                        </StackPanel.Styles>

                        <TextBlock
                            TextWrapping="Wrap"
                            Text="Dynastia is a generational family simulation. Keep the direct male lineage alive while managing marriage, children, health, careers, wealth, property, relationships, inheritance and unexpected events." />

                        <TextBlock
                            FontWeight="Bold"
                            Foreground="#E0B64C"
                            Text="Households" />

                        <TextBlock
                            TextWrapping="Wrap"
                            Text="Use the household tabs to switch between playable adult male-lineage characters. Selecting a spouse, child or relative changes the action target without changing the active household. Green household tabs have an action queued." />

                        <TextBlock
                            FontWeight="Bold"
                            Foreground="#E0B64C"
                            Text="Actions" />

                        <TextBlock
                            TextWrapping="Wrap"
                            Text="Choose one available action for the active household head. Some actions resolve immediately; queued actions resolve during the next annual simulation pass. Press Enter anywhere in the main game to advance exactly one year." />

                        <TextBlock
                            FontWeight="Bold"
                            Foreground="#E0B64C"
                            Text="Chronicle and personal details" />

                        <TextBlock
                            TextWrapping="Wrap"
                            Text="The Family Chronicle records events by year. Select a person to inspect skills, health, general information, relationships, About text and Biography." />

                        <TextBlock
                            FontWeight="Bold"
                            Foreground="#E0B64C"
                            Text="Genealogy" />

                        <TextBlock
                            TextWrapping="Wrap"
                            Text="Use View Tree in the household panel to open the zoomable genealogy tree. Clicking a person in the tree selects that person but does not switch the active household." />

                        <TextBlock
                            FontWeight="Bold"
                            Foreground="#E0B64C"
                            Text="Save and load" />

                        <TextBlock
                            TextWrapping="Wrap"
                            Text="Export creates a Dynastia save file. Load restores a previously exported desktop save, including people, relationships, plugin state, Chronicle, Biography, active household, selection and queued actions." />
                    </StackPanel>
                </ScrollViewer>

                <Button
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Width="130"
                    Padding="12,7"
                    Background="#102D26"
                    BorderBrush="#C99A39"
                    BorderThickness="1"
                    Foreground="#F4E5BE"
                    Content="Close"
                    Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
