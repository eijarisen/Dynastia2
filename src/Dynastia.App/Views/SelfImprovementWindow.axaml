<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Dynastia.App.Controls"
    xmlns:vm="using:Dynastia.App.ViewModels"
    x:Class="Dynastia.App.Views.SelfImprovementWindow"
    Width="960"
    Height="650"
    MinWidth="960"
    MinHeight="650"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    KeyDown="OnWindowKeyDown"
    Title="Self Improvement">

    <Window.Styles>
        <Style Selector="Button.paperAction">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Foreground" Value="#3F2714" />
            <Setter Property="Background" Value="#E8D5AF" />
            <Setter Property="BorderBrush" Value="#9D6F35" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Button.paperAction:pointerover">
            <Setter Property="Background" Value="#D4B178" />
            <Setter Property="Foreground" Value="#2D1A0E" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image
            Source="/Assets/UI/instructions_paper.png"
            Stretch="Fill" />

        <Grid
            Margin="76,58,76,48"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="8">

            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="avares://Dynastia.App/Assets/Fonts#UnifrakturCook"
                FontSize="38"
                Foreground="#2F1D0E"
                Text="Self Improvement" />

            <StackPanel
                Grid.Row="1"
                Spacing="2">
                <TextBlock
                    x:Name="TargetText"
                    HorizontalAlignment="Center"
                    FontFamily="Georgia"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="#3A2615"
                    TextAlignment="Center" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Georgia"
                    FontSize="12"
                    Foreground="#6A5131"
                    Text="Choose one improvement. Each costs 10,000 zł and uses this year's action." />
            </StackPanel>

            <Border
                Grid.Row="2"
                Padding="6"
                Background="#0FFFFFFF"
                BorderBrush="#8F6A34"
                BorderThickness="1.5"
                CornerRadius="6">

                <ItemsControl x:Name="OptionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelfImprovementOption">
                            <Border
                                Margin="2,1"
                                Padding="10,6"
                                MinHeight="57"
                                Background="#28FFF8E8"
                                BorderBrush="#A78959"
                                BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="120,*,220" ColumnSpacing="11">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Spacing="1">
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="#352615"
                                            Text="{Binding StatName}" />
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="11.5"
                                            Foreground="#6B5434"
                                            Text="{Binding CurrentValueText, StringFormat='Current: {0}'}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="1">
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="13.5"
                                            FontWeight="Bold"
                                            Foreground="#4B321B"
                                            Text="{Binding ActionLabel}" />
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="10.5"
                                            LineHeight="14"
                                            MaxWidth="405"
                                            MaxLines="3"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="#46351F"
                                            TextWrapping="Wrap"
                                            Text="{Binding Description}" />
                                    </StackPanel>

                                    <Grid
                                        Grid.Column="2"
                                        ColumnDefinitions="Auto,Auto"
                                        ColumnSpacing="8"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                        <StackPanel
                                            VerticalAlignment="Center"
                                            Spacing="1">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Georgia"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="#694914"
                                                Text="{Binding CostText}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Georgia"
                                                FontSize="10"
                                                Foreground="#745A38"
                                                Text="{Binding AvailabilityText}" />
                                        </StackPanel>
                                        <ui:ImageStateButton
                                            Grid.Column="1"
                                            Width="118"
                                            Height="50"
                                            IsEnabled="{Binding IsAvailable}"
                                            IdleSource="avares://Dynastia.App/Assets/UI/b_queue_idle.png"
                                            HoverSource="avares://Dynastia.App/Assets/UI/b_queue_hover.png"
                                            FallbackText="Queue"
                                            Click="OnQueueClick" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <ui:ImageStateButton
                Grid.Row="3"
                Width="170"
                Height="70"
                HorizontalAlignment="Center"
                IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                FallbackText="Close"
                Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
