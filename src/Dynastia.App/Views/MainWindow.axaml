<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Dynastia.App.ViewModels"
    xmlns:contracts="using:Dynastia.Contracts"
    x:Class="Dynastia.App.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d"
    Width="1180"
    Height="860"
    WindowState="Maximized"
    MinWidth="850"
    MinHeight="650"
    Title="Dynastia">


    <Window.Styles>
        <Style Selector="Button.playableTab">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,10,6" />
        </Style>

        <Style Selector="Button.playableTab.active">
            <Setter Property="BorderBrush" Value="#FACC15" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.playableTab.queued">
            <Setter Property="Background" Value="#16A34A" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.familyToggle">
            <Setter Property="Padding" Value="16,7" />
        </Style>

        <Style Selector="Button.familyToggle.active">
            <Setter Property="Background" Value="#475569" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.familyCard">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.familyCard.selected">
            <Setter Property="Background" Value="#334155" />
        </Style>

        <Style Selector="Button.familyCard.head">
            <Setter Property="BorderBrush" Value="#FACC15" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Window.Styles>

    <Grid>

        <Border
            IsVisible="{Binding IsStartScreenVisible}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="28"
            MinWidth="380">

            <StackPanel Spacing="14">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="34"
                    FontWeight="Bold"
                    Text="Dynastia" />

                <TextBlock
                    HorizontalAlignment="Center"
                    TextWrapping="Wrap"
                    Text="Enter your family's surname, or leave it blank for a random surname." />

                <TextBox
                    Watermark="e.g. Nowak"
                    Text="{Binding SurnameInput, Mode=TwoWay}" />

                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="12"
                    Content="Start Dynasty"
                    Command="{Binding StartGameCommand}" />
            </StackPanel>
        </Border>

        <Grid
            IsVisible="{Binding IsGameStarted}"
            RowDefinitions="Auto,Auto,Auto,*"
            Margin="16"
            RowSpacing="12">

            <Border Padding="16">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="16">

                    <StackPanel Spacing="2">
                        <TextBlock
                            FontSize="26"
                            FontWeight="Bold"
                            Text="{Binding DynastyTitle}" />

                        <TextBlock
                            FontSize="12"
                            Opacity="0.65"
                            Text="{Binding ActiveHouseholdText}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="{Binding Year}" />

                    <Button
                        Grid.Column="2"
                        Padding="18,10"
                        VerticalAlignment="Center"
                        Content="Next Year"
                        Command="{Binding NextYearCommand}" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="12">

                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="8">

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                          ColumnSpacing="8">

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Text="Family Album" />

                        <Button
                            Grid.Column="1"
                            Content="&lt;"
                            Command="{Binding PreviousAlbumYearCommand}" />

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding AlbumYear}" />

                        <Button
                            Grid.Column="3"
                            Content="&gt;"
                            Command="{Binding NextAlbumYearCommand}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <TextBlock
                            Opacity="0.65"
                            Text="{Binding AlbumEmptyText}" />

                        <ItemsControl ItemsSource="{Binding AlbumEvents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlbumEventViewModel">
                                    <TextBlock
                                        Margin="0,2"
                                        TextWrapping="Wrap"
                                        Text="{Binding Text}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Padding="12">

                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="8">

                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Text="Actions" />

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8"
                        IsVisible="{Binding HasQueuedAction}">

                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{Binding QueuedActionText}" />

                        <Button
                            Grid.Column="1"
                            Content="Cancel Action"
                            Command="{Binding CancelQueuedActionCommand}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <TextBlock
                            Opacity="0.65"
                            Text="{Binding ActionsEmptyText}" />

                        <ItemsControl ItemsSource="{Binding AvailableActions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AvailableActionViewModel">
                                    <Button
                                        Margin="0,0,8,6"
                                        Padding="12,7"
                                        Command="{Binding ExecuteCommand}"
                                        ToolTip.Tip="{Binding Description}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock
                                                FontSize="10"
                                                Opacity="0.6"
                                                Text="{Binding ModeText}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3"
                  ColumnDefinitions="3*,2*"
                  ColumnSpacing="16">


                <Border Padding="16">
                    <Grid
                        RowDefinitions="Auto,Auto,*"
                        RowSpacing="10">

                        <Grid
                            ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                            ColumnSpacing="8">

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="24"
                                FontWeight="Bold"
                                Text="Family" />

                            <Button
                                Grid.Column="1"
                                Content="View Tree"
                                IsEnabled="False"
                                ToolTip.Tip="Family tree will be added later." />

                            <Button
                                Grid.Column="3"
                                Classes="familyToggle"
                                Classes.active="{Binding IsLivingFamilyView}"
                                Content="Living"
                                Command="{Binding ShowLivingFamilyCommand}" />

                            <Button
                                Grid.Column="4"
                                Classes="familyToggle"
                                Classes.active="{Binding IsDeceasedFamilyView}"
                                Content="Deceased"
                                Command="{Binding ShowDeceasedFamilyCommand}" />
                        </Grid>

                        <ItemsControl
                            Grid.Row="1"
                            IsVisible="{Binding IsLivingFamilyView}"
                            ItemsSource="{Binding PlayableTabs}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlayablePersonTabViewModel">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="6">

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Opacity="0.75"
                                            Text="{Binding GenerationText}" />

                                        <Button
                                            Classes="playableTab"
                                            Classes.active="{Binding IsActive}"
                                            Classes.queued="{Binding HasQueuedAction}"
                                            Content="{Binding Label}"
                                            Command="{Binding SwitchCommand}"
                                            ToolTip.Tip="{Binding FullName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ScrollViewer
                            Grid.Row="2"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">

                            <Grid>

                                <StackPanel
                                    IsVisible="{Binding IsLivingFamilyView}"
                                    Spacing="10">

                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Spacing="2"
                                        Margin="0,2,0,6">

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="17"
                                            Text="{Binding HouseholdBudgetText}" />

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding HouseholdHousesText}" />

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Opacity="0.75"
                                            Text="{Binding HouseholdIncomeExpensesText}" />

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap"
                                            FontWeight="SemiBold"
                                            Foreground="#F59E0B"
                                            Text="{Binding HouseholdWarningText}" />
                                    </StackPanel>

                                    <ItemsControl
                                        HorizontalAlignment="Center"
                                        ItemsSource="{Binding HouseholdMembers}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FamilyMemberCardViewModel">
                                    <Button
                                        Classes="familyCard"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.head="{Binding IsActiveHouseholdHead}"
                                        Command="{Binding SelectCommand}"
                                        ToolTip.Tip="{Binding FullName}">

                                        <StackPanel
                                            Width="116"
                                            HorizontalAlignment="Center"
                                            Spacing="4">

                                            <Border
                                                Width="54"
                                                Height="54"
                                                HorizontalAlignment="Center"
                                                CornerRadius="27"
                                                BorderThickness="1"
                                                BorderBrush="#64748B">

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="28"
                                                    Text="{Binding AvatarText}" />
                                            </Border>

                                            <ProgressBar
                                                IsVisible="{Binding ShowHealth}"
                                                Width="82"
                                                Height="6"
                                                Minimum="0"
                                                Maximum="100"
                                                HorizontalAlignment="Center"
                                                Value="{Binding HealthValue}" />

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                FontWeight="SemiBold"
                                                Text="{Binding FullName}" />

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                FontSize="11"
                                                Opacity="0.75"
                                                Text="{Binding SubtitleText}" />

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                FontSize="10"
                                                Opacity="0.65"
                                                Text="{Binding OccupationText}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                    <Border
                                        Height="1"
                                        Margin="0,4"
                                        Background="#475569" />

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Text="Extended Family" />

                                    <ItemsControl
                                        HorizontalAlignment="Center"
                                        ItemsSource="{Binding ExtendedFamilyMembers}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FamilyMemberCardViewModel">
                                    <Button
                                        Classes="familyCard"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.head="{Binding IsActiveHouseholdHead}"
                                        Command="{Binding SelectCommand}"
                                        ToolTip.Tip="{Binding FullName}">

                                        <StackPanel
                                            Width="116"
                                            HorizontalAlignment="Center"
                                            Spacing="4">

                                            <Border
                                                Width="54"
                                                Height="54"
                                                HorizontalAlignment="Center"
                                                CornerRadius="27"
                                                BorderThickness="1"
                                                BorderBrush="#64748B">

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="28"
                                                    Text="{Binding AvatarText}" />
                                            </Border>

                                            <ProgressBar
                                                IsVisible="{Binding ShowHealth}"
                                                Width="82"
                                                Height="6"
                                                Minimum="0"
                                                Maximum="100"
                                                HorizontalAlignment="Center"
                                                Value="{Binding HealthValue}" />

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                FontWeight="SemiBold"
                                                Text="{Binding FullName}" />

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                FontSize="11"
                                                Opacity="0.75"
                                                Text="{Binding SubtitleText}" />

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                FontSize="10"
                                                Opacity="0.65"
                                                Text="{Binding OccupationText}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Opacity="0.6"
                                        Text="{Binding ExtendedFamilyEmptyText}" />
                                </StackPanel>

                                <StackPanel
                                    IsVisible="{Binding IsDeceasedFamilyView}"
                                    Spacing="10">

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Text="Deceased Family" />

                                    <ItemsControl
                                        HorizontalAlignment="Center"
                                        ItemsSource="{Binding DeceasedFamilyMembers}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FamilyMemberCardViewModel">
                                    <Button
                                        Classes="familyCard"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.head="{Binding IsActiveHouseholdHead}"
                                        Command="{Binding SelectCommand}"
                                        ToolTip.Tip="{Binding FullName}">

                                        <StackPanel
                                            Width="116"
                                            HorizontalAlignment="Center"
                                            Spacing="4">

                                            <Border
                                                Width="54"
                                                Height="54"
                                                HorizontalAlignment="Center"
                                                CornerRadius="27"
                                                BorderThickness="1"
                                                BorderBrush="#64748B">

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="28"
                                                    Text="{Binding AvatarText}" />
                                            </Border>

                                            <ProgressBar
                                                IsVisible="{Binding ShowHealth}"
                                                Width="82"
                                                Height="6"
                                                Minimum="0"
                                                Maximum="100"
                                                HorizontalAlignment="Center"
                                                Value="{Binding HealthValue}" />

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                FontWeight="SemiBold"
                                                Text="{Binding FullName}" />

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                FontSize="11"
                                                Opacity="0.75"
                                                Text="{Binding SubtitleText}" />

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                FontSize="10"
                                                Opacity="0.65"
                                                Text="{Binding OccupationText}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Opacity="0.6"
                                        Text="{Binding DeceasedFamilyEmptyText}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Padding="16">

                    <Grid RowDefinitions="Auto,Auto,Auto,*"
                          RowSpacing="14">

                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="24"
                                FontWeight="Bold"
                                Text="{Binding SelectedPerson.FullName,
                                               FallbackValue='Select a person'}" />

                            <TextBlock
                                Opacity="0.75"
                                Text="{Binding SelectedPerson.StatusText}" />
                        </StackPanel>

                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{Binding SelectedStats}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="contracts:StatValue">
                                    <Border
                                        Margin="0,0,8,8"
                                        Padding="10"
                                        MinWidth="92">

                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />

                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Text="{Binding Value}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel
                            Grid.Row="2"
                            Spacing="5"
                            IsVisible="{Binding SelectedPerson.ShowHealth}">

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding SelectedHealth.HealthText}" />

                            <ProgressBar
                                Minimum="0"
                                Maximum="100"
                                Height="10"
                                Value="{Binding SelectedHealth.Percentage}" />

                            <TextBlock
                                FontSize="12"
                                Opacity="0.75"
                                Text="{Binding SelectedHealth.ConditionsText}" />
                        </StackPanel>

                        <TabControl Grid.Row="3">

                            <TabItem Header="General">
                                <ScrollViewer>
                                    <StackPanel Margin="12"
                                                Spacing="8">

                                        <TextBlock Text="{Binding SelectedPerson.AgeText}" />
                                        <TextBlock Text="{Binding SelectedFamily.Sex, StringFormat='Sex: {0}'}" />

                                        <TextBlock Text="{Binding SelectedEducation.EducationText}" />
                                        <TextBlock Text="{Binding SelectedCareer.OccupationText}" />
                                        <TextBlock Text="{Binding SelectedCareer.SatisfactionText}" />
                                        <TextBlock Text="{Binding SelectedCareer.IncomeText}" />

                                        <TextBlock Text="{Binding SelectedPerson.BirthDateText}" />
                                        <TextBlock Text="{Binding SelectedPerson.DeathDateText}" />
                                        <TextBlock Text="{Binding SelectedPerson.MaidenNameText}" />
                                        <TextBlock Text="{Binding SelectedPerson.PlayableText}" />
                                        <TextBlock Text="{Binding SelectedFamily.Generation, StringFormat='Generation: {0}'}" />
                                        <TextBlock Text="{Binding SelectedFamily.Bloodline, StringFormat='Bloodline: {0}'}" />
                                        <TextBlock Text="{Binding SelectedFamily.MaleLineage, StringFormat='Male lineage: {0}'}" />

                                        <StackPanel
                                            IsVisible="{Binding HasSelectedEconomy}"
                                            Spacing="5"
                                            Margin="0,8,0,0">

                                            <TextBlock
                                                FontWeight="Bold"
                                                Text="Household" />

                                            <TextBlock Text="{Binding SelectedEconomy.WealthText}" />
                                            <TextBlock Text="{Binding SelectedEconomy.HousesText}" />
                                            <TextBlock Text="{Binding SelectedEconomy.RentedHousesText}" />
                                            <TextBlock Text="{Binding SelectedEconomy.IncomeText}" />
                                            <TextBlock Text="{Binding SelectedEconomy.ExpensesText}" />
                                            <TextBlock Text="{Binding SelectedEconomy.NetText}" />
                                            <TextBlock Text="{Binding SelectedEconomy.PendingInheritanceText}" />
                                            <TextBlock Text="{Binding SelectedEconomy.PendingHousesText}" />
                                            <TextBlock Text="{Binding SelectedEconomy.NannyText}" />

                                            <TextBlock
                                                TextWrapping="Wrap"
                                                FontWeight="SemiBold"
                                                Text="{Binding SelectedEconomy.WarningText}" />
                                        </StackPanel>

                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontWeight="SemiBold"
                                            Text="Tags" />

                                        <TextBlock
                                            TextWrapping="Wrap"
                                            Text="{Binding SelectedPerson.TagsText}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="About">
                                <TextBlock
                                    Margin="12"
                                    TextWrapping="Wrap"
                                    Text="About information will be generated from identity and stats." />
                            </TabItem>

                            <TabItem Header="Relationships">
                                <ScrollViewer>
                                    <StackPanel Margin="12"
                                                Spacing="8">

                                        <TextBlock Text="{Binding SelectedFamily.Father, StringFormat='Father: {0}'}" />
                                        <TextBlock Text="{Binding SelectedFamily.Mother, StringFormat='Mother: {0}'}" />
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="{Binding SelectedFamily.Siblings, StringFormat='Siblings: {0}'}" />
                                        <TextBlock Text="{Binding SelectedFamily.Spouse, StringFormat='Current spouse: {0}'}" />
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="{Binding SelectedFamily.Children, StringFormat='Children: {0}'}" />

                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontWeight="SemiBold"
                                            Text="Relationship history" />

                                        <TextBlock
                                            TextWrapping="Wrap"
                                            Text="{Binding SelectedFamily.RelationshipHistory}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Biography">
                                <TextBlock
                                    Margin="12"
                                    TextWrapping="Wrap"
                                    Text="Biography events will appear here." />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border
            IsVisible="{Binding IsGameOverOverlayVisible}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="32"
            MinWidth="430"
            MaxWidth="560"
            ZIndex="100">

            <StackPanel Spacing="16">

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="30"
                    FontWeight="Bold"
                    Text="{Binding GameOverTitle}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    FontSize="16"
                    Text="{Binding GameOverText}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Opacity="0.7"
                    Text="There are no living males remaining in the direct male lineage." />

                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="12"
                    Content="Go Back"
                    Command="{Binding GoBackFromGameOverCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
