<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Dynastia.App.Controls"
    x:Class="Dynastia.App.Views.InstructionsWindow"
    Width="1120"
    Height="860"
    MinWidth="900"
    MinHeight="700"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    Title="Dynastia — Instructions">

    <Window.Styles>
        <Style Selector="TabControl.instructionsTabs">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="TabControl.instructionsTabs TabStrip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="TabControl.instructionsTabs TabItem">
            <Setter Property="Foreground" Value="#3F2714" />
            <Setter Property="Background" Value="#E8D5AF" />
            <Setter Property="BorderBrush" Value="#9D6F35" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="TabControl.instructionsTabs TabItem:selected">
            <Setter Property="Background" Value="#D4B178" />
            <Setter Property="Foreground" Value="#2D1A0E" />
        </Style>

        <Style Selector="TabControl.instructionsTabs ContentPresenter">
            <Setter Property="Background" Value="#00FFFFFF" />
        </Style>

        <Style Selector="TextBlock.guideIntro">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#3A2615" />
            <Setter Property="LineHeight" Value="21" />
        </Style>

        <Style Selector="TextBlock.guideTip">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="#352110" />
            <Setter Property="LineHeight" Value="21" />
        </Style>

        <Style Selector="Border.tipCard">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#12FFF4D9" />
            <Setter Property="BorderBrush" Value="#5E8F6A34" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image
            Source="/Assets/UI/instructions_paper.png"
            Stretch="Fill" />

        <Grid
            Margin="80,72,80,58"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="12">

            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                FontSize="42"
                Foreground="#2F1D0E"
                Text="Instructions" />

            <TextBlock
                Grid.Row="1"
                Classes="guideIntro">
                <Run Text="Guide the dynasty year by year, keep its " />
                <Run FontWeight="Bold" Text="playable male line" />
                <Run Text=" alive and in Poland, and adapt to changing family, town and historical circumstances. Use action descriptions and tooltips for current costs, requirements and chances." />
            </TextBlock>

            <Border
                Grid.Row="2"
                Padding="8"
                Background="#0FFFFFFF"
                BorderBrush="#8F6A34"
                BorderThickness="1.5"
                CornerRadius="6">

                <TabControl
                    Classes="instructionsTabs"
                    SelectedIndex="0">

                    <TabItem Header="Basics">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,6" Spacing="2">
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Annual turn. " />
                                        <Run Text="Choose one action for every playable adult male household before advancing the year. Pass is always a valid choice." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Queued actions. " />
                                        <Run Text="Queued actions resolve at the start of the next year, before characters age." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Control and selection. " />
                                        <Run Text="The active household determines who you direct; selecting another person changes the details and action target you are viewing." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Autonomous family. " />
                                        <Run Text="Other bloodline households continue making their own work, family and household decisions without player orders." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Time and place matter. " />
                                        <Run Text="The starting year, town and region shape names, careers, education, medicine, institutions, finance, events and local opportunities." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Town Affairs. " />
                                        <Run Text="Use it to inspect local institutions, housing, jobs, healthcare, education, banking, Church, Court and Community life." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Family records. " />
                                        <Run Text="The Chronicle records major events, biographies follow individual lives, Thoughts show current concerns, and Genealogy follows the wider bloodline." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Map and saves. " />
                                        <Run Text="Use the Map to browse towns, dynasty presence and property. Export saves the game; Load restores it later." />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Family">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,6" Spacing="2">
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Lineage and bloodline. " />
                                        <Run Text="Direct male descendants determine playable succession; daughters and their descendants remain part of the wider family history and simulation." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Households. " />
                                        <Run Text="Several generations and branches can live together. Marriage, moving out, death, divorce, orphaning and succession can reorganize who shares a home." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Marriage. " />
                                        <Run Text="Seek a spouse or help resident relatives find one. Couples develop Marriage Satisfaction and may reconcile, have affairs, divorce or remarry. A household securely supported by passive income is not treated as unsupported merely because the husband has no job." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Children. " />
                                        <Run Text="Couples may have children, and nonmarital births can also occur. Children inherit family traits, appearance and identity with variation, and may have birth conditions." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Childhood and care. " />
                                        <Run Text="Children have Happiness and can be actively raised. Stable care can help unhappy children recover over time, while serious family shocks can have lasting effects. Nannies or resident family caregivers help with childcare, while crowding and family disruption can make childhood harder." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Orphans and adoption. " />
                                        <Run Text="Children who lose parents may remain with family, be taken in by another bloodline household, or enter orphan care depending on circumstances." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Family Relations. " />
                                        <Run Text="Relations persist between households. Relatives can improve ties, exchange money, houses or farmland, use career connections, and ask resident adults to move out." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Succession and estates. " />
                                        <Run Text="Household leadership changes across generations. Wealth, houses, farmland, heirlooms, debts and financial claims can continue through inheritance. Debts can pass to heirs alongside assets." />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="People">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,6" Spacing="2">
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Core traits. " />
                                        <Run Text="Immunity, Longevity, Fertility, Appeal, Strength and Intellect shape different parts of life and pass between generations with variation." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Acquired improvement. " />
                                        <Run Text="Some traits can be improved through costly training or medical opportunities when the era, person and local facilities allow it." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Personality and Morals. " />
                                        <Run Text="Temperament and moral character influence relationships, behavior, support, religion and some life choices; Morals can also change over time." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Health and Stress. " />
                                        <Run Text="Illness, injury, mental health, work, poverty, family circumstances and imprisonment can affect wellbeing. Wars and disasters may leave permanent injuries, while chronic conditions such as Gambling Disorder can create lasting risks. Treatment, recovery and psychotherapy can help." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Wellbeing choices. " />
                                        <Run Text="Recover can trade work output for rest, while alcohol may relieve immediate Stress but carries health and addiction risks. Burnout can emerge from sustained pressure." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Renown and Reputation. " />
                                        <Run Text="Social Status reflects a person's household, education, work, crafts, farming, civic activity and major events, and can matter in local opportunities." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Identity and appearance. " />
                                        <Run Text="People have nationality, name culture and birthplace. Appearance is partly inherited and portraits change with age; some assimilated dynasties may adopt a Polish surname." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Hobbies, Thoughts and aging. " />
                                        <Run Text="Pastimes and current concerns give people individual flavor. Everyone ages, and illness, accidents, historical events and ordinary mortality can end a life." />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Work &amp; Skills">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,6" Spacing="2">
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Education. " />
                                        <Run Text="Children can learn as they grow, while household members can pursue or support further study. Local schools and the historical era limit ordinary study, while affluent households can hire a private tutor for an eligible child even where schooling is weak or absent." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Employment. " />
                                        <Run Text="Jobs come from the local labour market. Education, abilities, experience, town institutions, regional strengths and social standing can all shape career opportunities." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Career life. " />
                                        <Run Text="Workers can gain experience, seek better jobs, advance, lose employment, become dissatisfied, retire and receive pensions based on their working lives." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Work choices. " />
                                        <Run Text="Work Harder, Recover, Quit and job-search actions let you trade health, satisfaction, income and career progress. Resident relatives can receive similar help." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Crafts. " />
                                        <Run Text="People can learn crafts, practice toward higher Mastery, teach relatives and work independently in a profession when their craft and local conditions permit it." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Artistic work. " />
                                        <Run Text="Artistic crafts can produce notable works that become family assets, build Status and may continue generating income." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Farming work. " />
                                        <Run Text="Local farmland can employ eligible household members. Children can provide limited farm help, while older and healthier available workers contribute more. All farms share the same annual weather, while livestock can soften crop-weather volatility. Output also depends on land and the surrounding economy." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Religious vocation. " />
                                        <Run Text="Some unmarried young adults may enter religious life where a Church exists. A vocation replaces ordinary employment and changes normal marriage and family options." />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Wealth &amp; Property">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,6" Spacing="2">
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Household budget. " />
                                        <Run Text="Wealth is managed at household level. Jobs, crafts, farming, pensions, rents, royalties and loans can bring money in while living costs and obligations take it out." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Lifestyle. " />
                                        <Run Text="A household can live lavishly, balance its spending or be thrifty, trading living costs against comfort, wellbeing and opportunity." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Housing. " />
                                        <Run Text="Buy and sell individual houses, extend owned homes, or move to another owned property. A household without a local home rents instead." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Investment property. " />
                                        <Run Text="Houses owned outside the household's residence can earn rent and later provide a destination for relocation rather than moving the family automatically." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Farmland and livestock. " />
                                        <Run Text="Households can buy, sell, receive and inherit farmland, add livestock, and use local parcels as productive family assets." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Loans. " />
                                        <Run Text="Borrowing and lending depend on the period and local financial institutions. Repayments and receivables remain part of the household's future finances and estate." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Heirlooms. " />
                                        <Run Text="Family objects can arise from achievements, wealth, hobbies, artistic work, historical events and deaths. They can be inherited, appraised, sold and sometimes produce income." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Family Inventory. " />
                                        <Run Text="Use it to review assets, debts, income, expenses and lifestyle choices without searching through individual character panels." />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Town &amp; Society">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,6" Spacing="2">
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Institutions and prosperity. " />
                                        <Run Text="Towns have changing institutions, prosperity and economic strengths. These shape services, jobs, education, healthcare, housing and other local opportunities." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Regional support. " />
                                        <Run Text="A region can favor particular industries, careers or crafts, so relocating may open opportunities that do not exist in the current town." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Church. " />
                                        <Run Text="Local Church life can include attendance, donations, direct charity, emergency welfare and Religious Study, with options depending on the person and institution." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Court and justice. " />
                                        <Run Text="The Court shows criminal records and local legal protection. Court quality and relatives in legal careers can matter when the family encounters the justice system." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Community policy. " />
                                        <Run Text="Towns generate temporary proposals and policies. The household can lobby a proposal, and successful policies can change local conditions for several years." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Civic office. " />
                                        <Run Text="Suitable residents may hold local office. Performing duties affects civic life and the officeholder's standing, while the office itself changes with the historical setting." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Community connections. " />
                                        <Run Text="Households can build relationships with local acquaintances, exchange gifts or assistance, and sometimes request money, housing or farmland outside the bloodline. Better-established households with strong local relationships can sometimes ask wealthy acquaintances for substantial help. Relationships fade after long neglect, while meaningful contact keeps them active." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Local Status. " />
                                        <Run Text="Renown is partly local: moving can reduce immediate recognition, while time, achievements, family networks and civic life can establish a household in its new community." />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Risks &amp; History">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,6" Spacing="2">
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Crime. " />
                                        <Run Text="Adults can become involved in crime, and a controlled adult can deliberately enter a persistent Life of Crime. A spouse cannot be ordered into crime; if they take up a Life of Crime, you can ask them to quit, with a chance that they refuse. Criminal choices can bring income, danger, records and imprisonment." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Prison. " />
                                        <Run Text="Imprisonment restricts ordinary actions, work and family life. Depending on circumstances, bail, escape attempts and eventual release may become relevant." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Rare events. " />
                                        <Run Text="Uncommon personal and household events can change health, wealth, property, careers or family circumstances, with eligibility depending on the current situation." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Historical events. " />
                                        <Run Text="Wars, political upheaval and other historical shocks can affect particular places and households, including health, finances, work, property and migration." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="A changing map. " />
                                        <Run Text="Towns can change name, status, population or political setting over time. Historical geography also influences nationalities, outsider origins and local opportunities." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Migration. " />
                                        <Run Text="Households may relocate within Poland or leave it because of historical circumstances. Relocation can cost property or work and changes the local world around the family." />
                                    </TextBlock>
                                </Border>
                                <Border Classes="tipCard">
                                    <TextBlock Classes="guideTip">
                                        <Run Text="• " />
                                        <Run FontWeight="Bold" Text="Dynasty end. " />
                                        <Run Text="The run ends if the playable male line disappears or no longer remains in Poland, even though other bloodline descendants may still be alive elsewhere." />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <ui:ImageStateButton
                Grid.Row="3"
                HorizontalAlignment="Center"
                Width="190"
                Height="62"
                IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                FallbackText="Close"
                Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
