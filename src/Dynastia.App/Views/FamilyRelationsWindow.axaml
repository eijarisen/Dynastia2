<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Dynastia.App.Controls"
    xmlns:vm="using:Dynastia.App.ViewModels"
    x:Class="Dynastia.App.Views.FamilyRelationsWindow"
    x:DataType="vm:FamilyRelationsWindowViewModel"
    Width="1000"
    Height="760"
    MinWidth="900"
    MinHeight="650"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    Title="Family Relations">

    <Window.Styles>
        <Style Selector="Button.relationAction">
            <Setter Property="Width" Value="170" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#E6D2AA" />
            <Setter Property="Foreground" Value="#3A2413" />
            <Setter Property="BorderBrush" Value="#93662F" />
            <Setter Property="BorderThickness" Value="1.3" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.relationAction:pointerover">
            <Setter Property="Background" Value="#D4AF73" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image Source="/Assets/UI/instructions_paper.png" Stretch="Fill" />

        <Grid Margin="80,72,80,58" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="avares://Dynastia.App/Assets/Fonts#UnifrakturCook"
                FontSize="42"
                Foreground="#2F1D0E"
                Text="Family Relations" />

            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontFamily="Georgia"
                FontSize="14"
                Foreground="#5B4024"
                Text="Close relatives living beyond the active household. Relationship history persists across generations." />

            <Border
                Grid.Row="2"
                Padding="8"
                Background="#0FFFFFFF"
                BorderBrush="#8F6A34"
                BorderThickness="1.5"
                CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Households}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FamilyRelationHouseholdViewModel">
                                <Border
                                    Margin="6,5"
                                    Padding="16,13"
                                    Background="#35FFF4D9"
                                    BorderBrush="#A17A43"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Grid ColumnDefinitions="*,190" ColumnSpacing="18">
                                        <StackPanel Spacing="7">
                                            <StackPanel Orientation="Horizontal" Spacing="0">
                                                <TextBlock
                                                    FontFamily="Georgia"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#352110"
                                                    Text="{Binding Kinship}" />
                                                <TextBlock
                                                    FontFamily="Georgia"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#352110"
                                                    Text=" — " />
                                                <TextBlock
                                                    FontFamily="Georgia"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#352110"
                                                    Text="{Binding RelativeName}" />
                                                <TextBlock
                                                    FontFamily="Georgia"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#352110"
                                                    Text=" (" />
                                                <TextBlock
                                                    FontFamily="Georgia"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding StateBrush}"
                                                    Text="{Binding State}" />
                                                <TextBlock
                                                    FontFamily="Georgia"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#352110"
                                                    Text=")" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="18">
                                                <TextBlock
                                                    FontFamily="Georgia"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="#5A3A18"
                                                    Text="{Binding TownText}" />
                                                <TextBlock
                                                    FontFamily="Georgia"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="#5A3A18"
                                                    Text="{Binding WealthText}" />
                                                <TextBlock
                                                    FontFamily="Georgia"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="#5A3A18"
                                                    Text="{Binding HousesText}" />
                                            </StackPanel>

                                            <TextBlock
                                                Margin="0,3,0,0"
                                                FontFamily="Georgia"
                                                FontSize="13"
                                                LineHeight="20"
                                                Foreground="#46321C"
                                                TextWrapping="Wrap"
                                                Text="{Binding OtherMembersText}" />
                                        </StackPanel>

                                        <ItemsControl
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            ItemsSource="{Binding Actions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Vertical" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FamilyRelationActionViewModel">
                                                    <Button
                                                        Classes="relationAction"
                                                        Content="{Binding Label}"
                                                        Click="OnActionClick">
                                                        <ToolTip.Tip>
                                                            <Border
                                                                MaxWidth="390"
                                                                Padding="9,7"
                                                                Background="#F20A1514"
                                                                BorderBrush="#B88934"
                                                                BorderThickness="1"
                                                                CornerRadius="4">
                                                                <TextBlock
                                                                    FontSize="10.5"
                                                                    LineHeight="17"
                                                                    Foreground="#F5E6C6"
                                                                    TextWrapping="Wrap"
                                                                    Text="{Binding Description}" />
                                                            </Border>
                                                        </ToolTip.Tip>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="4,0">
                <TextBlock
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasStatus}"
                    FontFamily="Georgia"
                    FontSize="12"
                    Foreground="#6B4521"
                    Text="{Binding StatusText}" />
                <ui:ImageStateButton
                    Grid.Column="1"
                    Width="170"
                    Height="70"
                    IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                    HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                    FallbackText="Close"
                    Click="OnCloseClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
