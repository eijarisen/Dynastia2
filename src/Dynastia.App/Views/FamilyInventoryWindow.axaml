<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Dynastia.App.Controls"
    xmlns:vm="using:Dynastia.App.ViewModels"
    x:Class="Dynastia.App.Views.FamilyInventoryWindow"
    x:DataType="vm:FamilyInventoryWindowViewModel"
    Width="1040"
    Height="800"
    MinWidth="1040"
    MinHeight="800"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    Title="Family Inventory">

    <Window.Styles>
        <Style Selector="Button.inventoryAction">
            <Setter Property="MinWidth" Value="136" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#E6D2AA" />
            <Setter Property="Foreground" Value="#3A2413" />
            <Setter Property="BorderBrush" Value="#93662F" />
            <Setter Property="BorderThickness" Value="1.3" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.inventoryAction:pointerover">
            <Setter Property="Background" Value="#D4AF73" />
        </Style>
        <Style Selector="Button.inventoryAction:disabled">
            <Setter Property="Opacity" Value="0.42" />
        </Style>
        <Style Selector="ComboBox.houseHeir">
            <Setter Property="MinWidth" Value="245" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#352110" />
            <Setter Property="Background" Value="#F2E2BD" />
            <Setter Property="BorderBrush" Value="#93662F" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#352110" />
            <Setter Property="Padding" Value="22,8" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image
            Source="/Assets/UI/instructions_paper.png"
            Stretch="Fill" />

        <Grid
            Margin="76,64,76,50"
            RowDefinitions="Auto,Auto,*,Auto"
            RowSpacing="10">

            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                FontSize="42"
                Foreground="#2F1D0E"
                Text="Family Inventory" />

            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontFamily="Georgia"
                FontSize="19"
                FontWeight="Bold"
                Foreground="#4B321B"
                Text="{Binding HouseholdName}" />

            <TabControl
                Grid.Row="2"
                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                Background="#0FFFFFFF"
                BorderBrush="#8F6A34"
                BorderThickness="1.5">

                <TabItem Header="Money">
                    <ScrollViewer
                        Margin="8"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Border
                                Margin="4"
                                Padding="16,13"
                                Background="#35FFF4D9"
                                BorderBrush="#A17A43"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid ColumnDefinitions="5*,6*" ColumnSpacing="20">
                                    <StackPanel Spacing="7">
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#352110"
                                            Text="{Binding BudgetText}" />

                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="#5A3A18"
                                            Text="{Binding IncomeTotalText}" />
                                        <ItemsControl ItemsSource="{Binding Incomes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InventoryFinanceLineViewModel">
                                                    <Grid Margin="0,1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="12"
                                                            Foreground="#46321C"
                                                            TextWrapping="Wrap"
                                                            Text="{Binding Label}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontFamily="Georgia"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            Text="{Binding AmountText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontFamily="Georgia"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="#5A3A18"
                                            Text="{Binding ExpenseTotalText}" />
                                        <ItemsControl ItemsSource="{Binding Expenses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InventoryFinanceLineViewModel">
                                                    <Grid Margin="0,1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="12"
                                                            Foreground="#46321C"
                                                            TextWrapping="Wrap"
                                                            Text="{Binding Label}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontFamily="Georgia"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            Text="{Binding AmountText}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <ui:HouseholdBudgetGraph
                                            Height="142"
                                            History="{Binding BudgetHistory}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontFamily="Georgia"
                                            FontSize="10"
                                            Foreground="#6B5131"
                                            Text="{Binding BudgetHistoryRangeText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="4" ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Border
                                    Padding="14,12"
                                    Background="#35FFF4D9"
                                    BorderBrush="#A17A43"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel Spacing="9">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Georgia"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Foreground="#352110"
                                                Text="💰 Loans" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                                <Button
                                                    Classes="inventoryAction"
                                                    MinWidth="105"
                                                    IsEnabled="{Binding CanTakeLoan}"
                                                    Content="Take Loan"
                                                    Click="OnTakeLoanClick" />
                                                <Button
                                                    Classes="inventoryAction"
                                                    MinWidth="105"
                                                    IsEnabled="{Binding CanGiveLoan}"
                                                    Content="Give Loan"
                                                    Click="OnGiveLoanClick" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="12"
                                            FontStyle="Italic"
                                            Foreground="#6B5131"
                                            Text="{Binding LoanEmptyText}" />

                                        <ItemsControl ItemsSource="{Binding Loans}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:InventoryLoanLineViewModel">
                                                    <StackPanel Margin="0,3" Spacing="1">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="12.5"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            Text="{Binding Title}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="11"
                                                            Foreground="#46321C"
                                                            TextWrapping="Wrap"
                                                            Text="{Binding DetailsText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="14,12"
                                    Background="#35FFF4D9"
                                    BorderBrush="#A17A43"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel Spacing="9">
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#352110"
                                            Text="🎩 Lifestyle Spending" />

                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="#5A3A18"
                                            Text="{Binding LifestyleText, StringFormat='Current: {0}'}" />

                                        <TextBlock
                                            MinHeight="48"
                                            FontFamily="Georgia"
                                            FontSize="11"
                                            Foreground="#6B5131"
                                            TextWrapping="Wrap"
                                            Text="{Binding LifestyleDescription}" />

                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                            <Button
                                                Grid.Column="0"
                                                Classes="inventoryAction"
                                                MinWidth="0"
                                                IsEnabled="{Binding CanUseLavishLifestyle}"
                                                Tag="economy.lifestyle.lavish"
                                                Content="Lavish"
                                                Click="OnLifestyleClick">
                                                <ToolTip.Tip>
                                                    <TextBlock
                                                        MaxWidth="290"
                                                        TextWrapping="Wrap"
                                                        Text="+25% living costs. Slightly improves child happiness, marriage and job satisfaction, health recovery, education and spouse prospects, while reducing Stress." />
                                                </ToolTip.Tip>
                                            </Button>
                                            <Button
                                                Grid.Column="1"
                                                Classes="inventoryAction"
                                                MinWidth="0"
                                                IsEnabled="{Binding CanUseBalancedLifestyle}"
                                                Tag="economy.lifestyle.balanced"
                                                Content="Balanced"
                                                Click="OnLifestyleClick">
                                                <ToolTip.Tip>
                                                    <TextBlock
                                                        MaxWidth="290"
                                                        TextWrapping="Wrap"
                                                        Text="Standard living costs with no Lifestyle bonuses or penalties." />
                                                </ToolTip.Tip>
                                            </Button>
                                            <Button
                                                Grid.Column="2"
                                                Classes="inventoryAction"
                                                MinWidth="0"
                                                IsEnabled="{Binding CanUseThriftyLifestyle}"
                                                Tag="economy.lifestyle.thrifty"
                                                Content="Thrifty"
                                                Click="OnLifestyleClick">
                                                <ToolTip.Tip>
                                                    <TextBlock
                                                        MaxWidth="290"
                                                        TextWrapping="Wrap"
                                                        Text="-20% living costs. Slightly lowers child happiness, marriage and job satisfaction, health recovery, education and spouse prospects, while increasing Stress." />
                                                </ToolTip.Tip>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Properties">
                    <ScrollViewer
                        Margin="8"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Border
                                Margin="4"
                                Padding="16,13"
                                Background="#35FFF4D9"
                                BorderBrush="#A17A43"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Georgia"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#352110"
                                            Text="Houses" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Classes="inventoryAction"
                                                IsEnabled="{Binding CanBuyHouse}"
                                                Content="Buy a House"
                                                Click="OnBuyHouseClick" />
                                            <Button
                                                Classes="inventoryAction"
                                                IsEnabled="{Binding CanSellHouse}"
                                                Content="Sell a House"
                                                Click="OnSellHouseClick" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        FontFamily="Georgia"
                                        FontSize="12"
                                        FontStyle="Italic"
                                        Foreground="#6B5131"
                                        Text="{Binding HouseEmptyText}" />

                                    <ItemsControl ItemsSource="{Binding Houses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:InventoryHouseViewModel">
                                                <Grid Margin="0,4" ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="13.5"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            Text="{Binding TownText}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="11.5"
                                                            Foreground="#6B5131"
                                                            Text="{Binding StatusText}" />
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Spacing="8">
                                                        <Button
                                                            Classes="inventoryAction"
                                                            IsEnabled="{Binding CanExtend}"
                                                            Tag="{Binding PropertyId}"
                                                            Content="{Binding ExtendActionText}"
                                                            Click="OnExtendHouseClick" />
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontFamily="Georgia"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            Text="Inherits:" />
                                                        <ComboBox
                                                            Classes="houseHeir"
                                                            ItemsSource="{Binding HeirOptions}"
                                                            SelectedItem="{Binding SelectedHeir, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:HouseHeirOptionViewModel">
                                                                    <TextBlock
                                                                        FontFamily="Georgia"
                                                                        FontSize="12"
                                                                        Foreground="#352110"
                                                                        Text="{Binding Label}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="4"
                                Padding="16,13"
                                Background="#35FFF4D9"
                                BorderBrush="#A17A43"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Georgia"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#352110"
                                            Text="{Binding FarmlandTitle}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button
                                                Classes="inventoryAction"
                                                IsEnabled="{Binding CanBuyFarmland}"
                                                Content="{Binding BuyFarmlandActionText}"
                                                Click="OnBuyFarmlandClick" />
                                            <Button
                                                Classes="inventoryAction"
                                                IsEnabled="{Binding CanSellFarmland}"
                                                Content="{Binding SellFarmlandActionText}"
                                                Click="OnSellFarmlandClick" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        FontFamily="Georgia"
                                        FontSize="12"
                                        FontStyle="Italic"
                                        Foreground="#6B5131"
                                        Text="{Binding FarmlandEmptyText}" />

                                    <TextBlock
                                        FontFamily="Georgia"
                                        FontSize="11.5"
                                        Foreground="#5A3A18"
                                        TextWrapping="Wrap"
                                        Text="{Binding FarmlandSummaryText}" />

                                    <ItemsControl ItemsSource="{Binding Farmland}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:InventoryFarmlandViewModel">
                                                <Grid Margin="0,4" ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="13.5"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            Text="{Binding TownText}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="11.5"
                                                            Foreground="#6B5131"
                                                            Text="{Binding StatusText}" />
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Spacing="8">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontFamily="Georgia"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            Text="Inherits:" />
                                                        <ComboBox
                                                            Classes="houseHeir"
                                                            ItemsSource="{Binding HeirOptions}"
                                                            SelectedItem="{Binding SelectedHeir, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:HouseHeirOptionViewModel">
                                                                    <TextBlock
                                                                        FontFamily="Georgia"
                                                                        FontSize="12"
                                                                        Foreground="#352110"
                                                                        Text="{Binding Label}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="4"
                                Padding="16,13"
                                Background="#35FFF4D9"
                                BorderBrush="#A17A43"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel Spacing="9">
                                    <TextBlock
                                        FontFamily="Georgia"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="#352110"
                                        Text="Heirlooms" />

                                    <TextBlock
                                        FontFamily="Georgia"
                                        FontSize="12"
                                        FontStyle="Italic"
                                        Foreground="#6B5131"
                                        Text="{Binding HeirloomEmptyText}" />

                                    <ItemsControl ItemsSource="{Binding Heirlooms}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:InventoryHeirloomViewModel">
                                                <Grid Margin="0,5" ColumnDefinitions="48,*,Auto" ColumnSpacing="12" ToolTip.Tip="{Binding OriginText}">
                                                    <Border
                                                        Width="42"
                                                        Height="42"
                                                        VerticalAlignment="Center"
                                                        Background="#55F4E4BC"
                                                        BorderBrush="#9C7440"
                                                        BorderThickness="1"
                                                        CornerRadius="3">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="23"
                                                            Text="{Binding Emoji}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="13.5"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            TextWrapping="Wrap"
                                                            Text="{Binding DisplayName}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="11.5"
                                                            Foreground="#6B5131"
                                                            Text="{Binding DetailsText}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="11"
                                                            Foreground="#7A5C37"
                                                            TextTrimming="CharacterEllipsis"
                                                            Text="{Binding OriginText}" />
                                                    </StackPanel>

                                                    <StackPanel
                                                        Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Spacing="8">
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontFamily="Georgia"
                                                            FontSize="12"
                                                            FontWeight="Bold"
                                                            Foreground="#46321C"
                                                            Text="Inherits:" />
                                                        <ComboBox
                                                            Classes="houseHeir"
                                                            ItemsSource="{Binding HeirOptions}"
                                                            SelectedItem="{Binding SelectedHeir, Mode=TwoWay}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:HouseHeirOptionViewModel">
                                                                    <TextBlock
                                                                        FontFamily="Georgia"
                                                                        FontSize="12"
                                                                        Foreground="#352110"
                                                                        Text="{Binding Label}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <Button
                                                            Classes="inventoryAction"
                                                            IsEnabled="{Binding CanSell}"
                                                            Tag="{Binding HeirloomId}"
                                                            Content="Sell"
                                                            Click="OnSellHeirloomClick" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <ui:ImageStateButton
                Grid.Row="3"
                Width="170"
                Height="70"
                HorizontalAlignment="Center"
                IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                FallbackText="Close"
                Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
