<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Dynastia.App.Controls"
    xmlns:vm="using:Dynastia.App.ViewModels"
    x:Class="Dynastia.App.Views.FamilyRelationsWindow"
    x:DataType="vm:FamilyRelationsWindowViewModel"
    Width="1000"
    Height="760"
    MinWidth="900"
    MinHeight="650"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    Title="Family Relations">

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="Button.relationAction">
            <Setter Property="Width" Value="170" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#E6D2AA" />
            <Setter Property="Foreground" Value="#3A2413" />
            <Setter Property="BorderBrush" Value="#93662F" />
            <Setter Property="BorderThickness" Value="1.3" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.relationAction:pointerover">
            <Setter Property="Background" Value="#D4AF73" />
        </Style>
        <Style Selector="Button.householdName">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#352110" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.householdName:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6B4521" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image Source="/Assets/UI/instructions_paper.png" Stretch="Fill" />

        <Grid Margin="80,72,80,58" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                FontSize="42"
                Foreground="#2F1D0E"
                Text="Family Relations" />

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                Spacing="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Georgia"
                    FontSize="19"
                    FontWeight="Bold"
                    Foreground="#4B321B"
                    Text="{Binding SelectedHouseholdText}" />
            </StackPanel>

            <TabControl Grid.Row="2">
                <TabItem Header="Family">
                    <Border
                        Padding="8"
                        Background="#0FFFFFFF"
                        BorderBrush="#8F6A34"
                        BorderThickness="1.5"
                        CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <ItemsControl ItemsSource="{Binding Households}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FamilyRelationHouseholdViewModel">
                                        <Border
                                            Margin="6,5"
                                            Padding="16,13"
                                            Background="#35FFF4D9"
                                            BorderBrush="#A17A43"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Grid ColumnDefinitions="*,190" ColumnSpacing="18">
                                                <StackPanel Spacing="7">
                                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="#352110"
                                                            Text="{Binding Kinship}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="#352110"
                                                            Text=" — " />
                                                        <Button
                                                            Classes="householdName"
                                                            IsVisible="{Binding IsPlayableHousehold}"
                                                            Content="{Binding RelativeName}"
                                                            Click="OnHouseholdNameClick" />
                                                        <TextBlock
                                                            IsVisible="{Binding IsNonPlayableHousehold}"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Georgia"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="#91877B"
                                                            Text="{Binding RelativeName}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="#352110"
                                                            Text=" (" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="{Binding StateBrush}"
                                                            Text="{Binding RelationState}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="#352110"
                                                            Text=")" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="#5A3A18"
                                                            Text="{Binding TownText}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="#5A3A18"
                                                            Text="{Binding WealthText}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="#5A3A18"
                                                            Text="{Binding HousesText}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="#5A3A18"
                                                            Text="{Binding FarmlandText}" />
                                                    </StackPanel>

                                                    <ItemsControl
                                                        Margin="0,3,0,0"
                                                        ItemsSource="{Binding Members}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:FamilyRelationMemberViewModel">
                                                                <StackPanel
                                                                    Margin="0,1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="7">
                                                                    <Border
                                                                        Width="25"
                                                                        Height="25"
                                                                        VerticalAlignment="Center"
                                                                        Background="#54000000"
                                                                        BorderBrush="#9D772E"
                                                                        BorderThickness="1"
                                                                        CornerRadius="3">
                                                                        <TextBlock
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="16"
                                                                            Text="{Binding PortraitEmoji}" />
                                                                    </Border>
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontFamily="Georgia"
                                                                        FontSize="13"
                                                                        Foreground="#46321C"
                                                                        TextWrapping="Wrap"
                                                                        Text="{Binding Text}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <ItemsControl
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    ItemsSource="{Binding Actions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Vertical" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:FamilyRelationActionViewModel">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <ComboBox
                                                                    Width="155"
                                                                    IsVisible="{Binding HasInlinePropertySelection}"
                                                                    ItemsSource="{Binding InlinePropertyOptions}"
                                                                    SelectedItem="{Binding SelectedInlineProperty}">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:PropertySelectionOption">
                                                                            <TextBlock
                                                                                MaxWidth="140"
                                                                                Text="{Binding PrimaryText}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                                <Button
                                                                    Classes="relationAction"
                                                                    Content="{Binding Label}"
                                                                    Click="OnActionClick">
                                                                    <ToolTip.Tip>
                                                                        <Border
                                                                            MaxWidth="390"
                                                                            Padding="9,7"
                                                                            Background="#F20A1514"
                                                                            BorderBrush="#B88934"
                                                                            BorderThickness="1"
                                                                            CornerRadius="4">
                                                                            <TextBlock
                                                                                FontSize="10.5"
                                                                                LineHeight="17"
                                                                                Foreground="#F5E6C6"
                                                                                TextWrapping="Wrap"
                                                                                Text="{Binding Description}" />
                                                                        </Border>
                                                                    </ToolTip.Tip>
                                                                </Button>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>
                <TabItem Header="Acquaintances">
                    <Border
                        Padding="8"
                        Background="#0FFFFFFF"
                        BorderBrush="#8F6A34"
                        BorderThickness="1.5"
                        CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    IsVisible="{Binding ShowNoConnections}"
                                    Margin="0,28,0,0"
                                    HorizontalAlignment="Center"
                                    FontFamily="Georgia"
                                    FontSize="14"
                                    FontStyle="Italic"
                                    Foreground="#6B4521"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    Text="No acquaintances are currently known to this household." />
                                <ItemsControl IsVisible="{Binding HasConnections}" ItemsSource="{Binding Connections}">
                                    <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HouseholdConnectionViewModel">
                                        <Border
                                            Margin="6,5"
                                            Padding="16,13"
                                            Background="#35FFF4D9"
                                            BorderBrush="#A17A43"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <Grid ColumnDefinitions="100,*,190" ColumnSpacing="14">
                                                <Border
                                                    Width="88"
                                                    Height="112"
                                                    VerticalAlignment="Top"
                                                    Background="#54000000"
                                                    BorderBrush="#9D772E"
                                                    BorderThickness="1.5"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center"
                                                        FontSize="62"
                                                        Text="{Binding PortraitEmoji}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="#352110"
                                                            Text="{Binding Name}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="#352110"
                                                            Text=" (" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="{Binding StateBrush}"
                                                            Text="{Binding RelationState}" />
                                                        <TextBlock
                                                            FontFamily="Georgia"
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="#352110"
                                                            Text=")" />
                                                    </StackPanel>
                                                    <TextBlock FontFamily="Georgia" FontSize="13" Foreground="#46321C" TextWrapping="Wrap" Text="{Binding ProfileText}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="18">
                                                        <TextBlock FontFamily="Georgia" FontSize="13" FontWeight="Bold" Foreground="#5A3A18" Text="{Binding WealthText}" />
                                                        <TextBlock FontFamily="Georgia" FontSize="13" FontWeight="Bold" Foreground="#5A3A18" Text="{Binding StatusText}" />
                                                    </StackPanel>
                                                    <TextBlock FontFamily="Georgia" FontSize="12.5" Foreground="#5A4630" TextWrapping="Wrap" Text="{Binding FamilyText}" />
                                                    <TextBlock FontFamily="Georgia" FontSize="12.5" Foreground="#5A4630" TextWrapping="Wrap" Text="{Binding AssetsText}" />
                                                </StackPanel>
                                                <ItemsControl
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    ItemsSource="{Binding Actions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Vertical" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:HouseholdConnectionActionViewModel">
                                                            <Button
                                                                Classes="relationAction"
                                                                Content="{Binding Label}"
                                                                Click="OnConnectionActionClick">
                                                                <ToolTip.Tip>
                                                                    <Border
                                                                        MaxWidth="390"
                                                                        Padding="9,7"
                                                                        Background="#F20A1514"
                                                                        BorderBrush="#B88934"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4">
                                                                        <TextBlock
                                                                            FontSize="10.5"
                                                                            LineHeight="17"
                                                                            Foreground="#F5E6C6"
                                                                            TextWrapping="Wrap"
                                                                            Text="{Binding Description}" />
                                                                    </Border>
                                                                </ToolTip.Tip>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="4,0">
                <TextBlock
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasStatus}"
                    FontFamily="Georgia"
                    FontSize="12"
                    Foreground="#6B4521"
                    Text="{Binding StatusText}" />
                <ui:ImageStateButton
                    Grid.Column="1"
                    Width="170"
                    Height="70"
                    IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                    HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                    FallbackText="Close"
                    Click="OnCloseClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
