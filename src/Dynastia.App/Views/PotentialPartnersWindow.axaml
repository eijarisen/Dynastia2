<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Dynastia.App.Controls"
    xmlns:primitives="using:Avalonia.Controls.Primitives"
    xmlns:vm="using:Dynastia.App.ViewModels"
    xmlns:conv="using:Dynastia.App.Converters"
    xmlns:contracts="using:Dynastia.Contracts"
    x:Class="Dynastia.App.Views.PotentialPartnersWindow"
    x:DataType="vm:PotentialPartnerDialogViewModel"
    Width="940"
    Height="780"
    CanResize="False"
    ShowInTaskbar="False"
    WindowDecorations="None"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterOwner"
    Background="#00000000"
    KeyDown="OnWindowKeyDown"
    Title="Potential Partners">

    <Window.Resources>
        <conv:StatValueBrushConverter x:Key="StatValueBrushConverter" />
    </Window.Resources>

    <Grid>
        <Image Source="/Assets/UI/instructions_paper.png" Stretch="Fill" />

        <Grid Margin="62,42,62,38" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="7">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="avares://Dynastia.App/Assets/Fonts#Pirata One"
                FontSize="38"
                Foreground="#2F1D0E"
                Text="Potential Partners" />

            <TextBlock
                Grid.Row="1"
                HorizontalAlignment="Center"
                FontFamily="Georgia"
                FontSize="13"
                Foreground="#5B4024"
                Text="{Binding IntroText}" />

            <ItemsControl
                Grid.Row="2"
                VerticalAlignment="Center"
                ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <primitives:UniformGrid Columns="2" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PotentialPartnerCardViewModel">
                        <Border
                            Height="258"
                            Margin="5"
                            Padding="10,9"
                            Background="#35FFF4D9"
                            BorderBrush="#A17A43"
                            BorderThickness="1"
                            CornerRadius="4"
                            Cursor="Hand"
                            PointerPressed="OnCandidatePointerPressed">
                            <Grid RowDefinitions="*,Auto" RowSpacing="7">
                                <Grid ColumnDefinitions="104,*" ColumnSpacing="10">
                                    <Border
                                        Width="96"
                                        Height="116"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="#54000000"
                                        BorderBrush="#9D772E"
                                        BorderThickness="1.5"
                                        CornerRadius="4">
                                        <TextBlock
                                            Margin="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap"
                                            FontSize="64"
                                            Text="{Binding PortraitEmoji}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="#352110"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Heading}" />
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="11"
                                            FontStyle="Italic"
                                            FontWeight="Bold"
                                            Foreground="#6A451A"
                                            Text="{Binding PersonalityText}" />
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="#5A3A18"
                                            TextWrapping="Wrap"
                                            Text="{Binding OriginNationalityText}" />
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="10.8"
                                            Foreground="#3F2B19"
                                            TextWrapping="Wrap"
                                            Text="{Binding OccupationText}" />
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="10.8"
                                            Foreground="#3F2B19"
                                            Text="{Binding EducationText}" />
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="10.8"
                                            Foreground="#3F2B19"
                                            TextWrapping="Wrap"
                                            Text="{Binding CraftsText}" />
                                        <TextBlock
                                            IsVisible="{Binding HasFinancialEstimate}"
                                            FontFamily="Georgia"
                                            FontSize="10.3"
                                            FontWeight="SemiBold"
                                            Foreground="#5A3A18"
                                            TextWrapping="Wrap"
                                            Text="{Binding FinancialText}" />
                                        <StackPanel
                                            IsVisible="{Binding HasStatus}"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                FontFamily="Georgia"
                                                FontSize="11"
                                                Foreground="#5A3A18"
                                                Text="Status:" />
                                            <TextBlock
                                                FontFamily="Georgia"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{Binding RenownStatusBrush}"
                                                Text="{Binding RenownStatusText}" />
                                            <TextBlock
                                                FontFamily="Georgia"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{Binding ReputationStatusBrush}"
                                                Text="{Binding ReputationStatusText}" />
                                        </StackPanel>
                                        <TextBlock
                                            FontFamily="Georgia"
                                            FontSize="10.8"
                                            FontWeight="Bold"
                                            Foreground="{Binding SuccessChanceBrush}"
                                            Text="{Binding SuccessChanceText}" />
                                    </StackPanel>
                                </Grid>

                                <Border
                                    Grid.Row="1"
                                    Padding="5,4"
                                    Background="#D00A0705"
                                    BorderBrush="#765028"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <ItemsControl ItemsSource="{Binding Stats}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <primitives:UniformGrid Columns="6" Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="contracts:StatValue">
                                                <StackPanel Spacing="0">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        TextAlignment="Center"
                                                        FontSize="7.2"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding Value, Converter={StaticResource StatValueBrushConverter}}"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontFamily="Georgia"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="{Binding Value, Converter={StaticResource StatValueBrushConverter}}"
                                                        Text="{Binding Value}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:ImageStateButton
                Grid.Row="3"
                Width="170"
                Height="60"
                HorizontalAlignment="Center"
                IdleSource="avares://Dynastia.App/Assets/UI/b_close_idle.png"
                HoverSource="avares://Dynastia.App/Assets/UI/b_close_hover.png"
                FallbackText="Close"
                Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
